<Window x:Class="TriggerPoint.UI.Views.CommandPaletteView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TriggerPoint.UI.Views"
        Title="TriggerPoint Command Palette"
        Width="720"
        Height="520"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Topmost="True"
        ShowInTaskbar="False"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Command Palette Header Icon Button Style -->
        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemSelectedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Command Palette Header Sort Dropdown Button Style -->
        <Style x:Key="HeaderSortButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemSelectedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Command Palette Scope Dismiss Button Style -->
        <Style x:Key="ScopeDismissButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Pill Button Style -->
        <Style x:Key="FilterPillStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Padding" Value="7,2.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="pillBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Pill Ctrl Shortcut Badge Styles -->
        <Style x:Key="PillCtrlBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,-3,0"/>
            <Setter Property="Panel.ZIndex" Value="10"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.45" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillCtrlBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- Calculator Guide Tab Button Style -->
        <Style x:Key="CalcGuideTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="tabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Calculator Keypad Operator Button Style -->
        <Style x:Key="CalcKeypadButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource CodeFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="keyBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="keyBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                <Setter TargetName="keyBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="keyBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Calculator Alternative Unit Micro-Pill Style -->
        <Style x:Key="CalcUnitPillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- More Units Trigger Button Style -->
        <Style x:Key="CalcMoreUnitsButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="moreBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="moreBorder" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Calculator Action Button Style -->
        <Style x:Key="CalcUnitActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="actBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="actBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                <Setter TargetName="actBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Category Filter Chip Style -->
        <Style x:Key="CalcCategoryChipStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.55" Direction="270"/>
        </Border.Effect>

        <Grid Margin="16,14,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Search & Scope Header -->
                <RowDefinition Height="Auto"/> <!-- Filter Pills Bar -->
                <RowDefinition Height="*"/>    <!-- Results List & Empty State -->
                <RowDefinition Height="Auto"/> <!-- Selected Item Detail Preview Strip -->
                <RowDefinition Height="Auto"/> <!-- Contextual Footer Bar -->
            </Grid.RowDefinitions>

            <!-- Row 0: Search Input & Controls Box -->
            <Border Grid.Row="0"
                    x:Name="SearchBoxBorder"
                    Panel.ZIndex="1"
                    Background="{DynamicResource BgInputBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Back Button (Scoped) -->
                        <ColumnDefinition Width="Auto"/> <!-- Search Icon -->
                        <ColumnDefinition Width="*"/>    <!-- Search Text Box & Watermark -->
                        <ColumnDefinition Width="Auto"/> <!-- Scope Badge -->
                        <ColumnDefinition Width="Auto"/> <!-- Header Utility Buttons -->
                    </Grid.ColumnDefinitions>

                    <!-- Back Button when Scoped into Folder -->
                    <Button Grid.Column="0" 
                            x:Name="BackButton"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            ToolTip="Go back to parent folder (Backspace)"
                            Click="BackButton_Click"
                            Margin="0,0,4,0"
                            Visibility="Collapsed">
                        <TextBlock Text="←" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    </Button>

                    <!-- Search Icon -->
                    <TextBlock Grid.Column="1" 
                               Text="🔍" 
                               FontSize="14" 
                               Margin="0,0,8,0" 
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"/>

                    <!-- Search Box with Placeholder -->
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <TextBox x:Name="SearchTextBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 FontSize="14.5"
                                 VerticalAlignment="Center"
                                 TextChanged="SearchTextBox_TextChanged"/>

                        <!-- Search Watermark Placeholder -->
                        <TextBlock x:Name="SearchWatermark"
                                   Text="Search actions, type @ for filters, = for math, or ? for help..."
                                   FontSize="13.5"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Visibility="Visible"/>
                    </Grid>

                    <!-- Scope Badge with Dismiss Button -->
                    <Border Grid.Column="3" 
                            x:Name="ScopeBadge"
                            Background="{DynamicResource AccentSubtleBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,2"
                            Margin="6,0,6,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ScopeText" 
                                       Text="Scoped" 
                                       FontSize="11" 
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="ScopeDismissBtn"
                                    Style="{StaticResource ScopeDismissButtonStyle}"
                                    Click="ScopeDismissBtn_Click"
                                    ToolTip="Clear folder filter (Esc)">
                                <TextBlock Text="✕" FontSize="9.5" Foreground="{DynamicResource AccentBrush}"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Header Utility Buttons -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Sort Mode Switcher Dropdown -->
                        <Button x:Name="SortModeBtn"
                                Style="{StaticResource HeaderSortButtonStyle}"
                                Click="SortModeBtn_Click"
                                ToolTip="Select sort mode (Ctrl+S)">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="SortContextMenu">
                                    <MenuItem x:Name="SortItemSmart" Header="Smart (Fuzzy Score &amp; Recents)" Click="SortMenuItem_Click" Tag="Smart"/>
                                    <MenuItem x:Name="SortItemAlpha" Header="Alphabetical (A–Z)" Click="SortMenuItem_Click" Tag="Alphabetical"/>
                                    <MenuItem x:Name="SortItemFreq" Header="Most Frequent" Click="SortMenuItem_Click" Tag="MostFrequent"/>
                                    <MenuItem x:Name="SortItemRecent" Header="Recent" Click="SortMenuItem_Click" Tag="Recent"/>
                                    <MenuItem x:Name="SortItemTree" Header="Action Tree Order" Click="SortMenuItem_Click" Tag="ActionTree"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="↕ " FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock x:Name="SortModeText" Text="Smart" FontSize="11" FontWeight="Medium" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text=" ▾" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Action Manager Button (TriggerPoint Logo) -->
                        <Button x:Name="ActionManagerBtn"
                                Style="{StaticResource HeaderIconButtonStyle}"
                                Click="ActionManagerBtn_Click"
                                ToolTip="Action Manager (Ctrl+M)">
                            <Image Source="{DynamicResource AppIconSource}" 
                                   Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>

                        <!-- Application Settings Button -->
                        <Button x:Name="AppSettingsBtn"
                                Style="{StaticResource HeaderIconButtonStyle}"
                                Click="AppSettingsBtn_Click"
                                ToolTip="Application Settings (Ctrl+,)">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Width="14" Height="14" 
                                      Stretch="Uniform" 
                                      Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="{DynamicResource SettingsGearGeometry}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                <Ellipse x:Name="AppSettingsUpdateBadge"
                                         Width="6" Height="6"
                                         Fill="{DynamicResource AccentBrush}"
                                         Stroke="{DynamicResource BgSecondaryBrush}"
                                         StrokeThickness="1"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Margin="0,-2,-2,0"
                                         Visibility="Collapsed"/>
                            </Grid>
                        </Button>

                        <!-- Shortcut & Help Cheat-Sheet Button -->
                        <Button x:Name="HelpOverlayBtn"
                                Style="{StaticResource HeaderIconButtonStyle}"
                                Click="HelpOverlayBtn_Click"
                                ToolTip="Keyboard Shortcuts &amp; Search Hints (F1 or ?)">
                            <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1" 
                                    BorderBrush="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <TextBlock Text="i" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center" 
                                           Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                           Margin="0,-1,0,0"/>
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- @ Filter Prefix Autocomplete Popup -->
            <Popup x:Name="PrefixAutoCompletePopup"
                   PlacementTarget="{Binding ElementName=SearchBoxBorder}"
                   Placement="Bottom"
                   AllowsTransparency="True"
                   Focusable="False"
                   StaysOpen="False"
                   VerticalOffset="4"
                   PopupAnimation="Fade">
                <Border Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Width="320"
                        Padding="4"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Padding="8,4,8,4" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,4">
                            <TextBlock Text="FILTER BY TYPE" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Border>
                        <ListBox x:Name="PrefixSuggestionsList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionMode="Single"
                                 PreviewMouseLeftButtonUp="PrefixSuggestionsList_PreviewMouseLeftButtonUp">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="pBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        Padding="8,5"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="pBorder" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="pBorder" Property="Background" Value="{DynamicResource ItemSelectedBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="13" Width="22" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,8,0">
                                            <TextBlock Text="{Binding Prefix}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="  " FontSize="12"/>
                                            <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" 
                                                Style="{DynamicResource KeyBadgeStyle}" 
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ShortcutHint}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Row 1: Filter Pills Bar -->
            <Border Grid.Row="1" x:Name="FilterPillsBar" Panel.ZIndex="50" Margin="0,0,0,6" ClipToBounds="False">
                <ScrollViewer x:Name="FilterPillsScrollViewer"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              Focusable="False"
                              Padding="2,0,16,2"
                              PreviewMouseWheel="FilterPillsScrollViewer_PreviewMouseWheel"
                              ClipToBounds="False">
                    <StackPanel Orientation="Horizontal" ClipToBounds="False">
                        <!-- Filter Pill: All -->
                        <Grid ClipToBounds="False" Margin="0,0,12,0">
                            <Button x:Name="FilterPillAll" 
                                    Click="FilterPill_Click" 
                                    Tag="All" 
                                    Margin="0,7,0,0"
                                    Style="{StaticResource FilterPillStyle}">
                                <TextBlock x:Name="FilterCountAll" Text="All (0)"/>
                            </Button>
                            <Border x:Name="PillShortcutAll" Style="{StaticResource PillCtrlBadgeStyle}" Visibility="Collapsed">
                                <TextBlock Text="Ctrl+1" Style="{StaticResource PillCtrlBadgeTextStyle}"/>
                            </Border>
                        </Grid>

                        <!-- Filter Pill: Apps -->
                        <Grid ClipToBounds="False" Margin="0,0,12,0">
                            <Button x:Name="FilterPillApp" 
                                    Click="FilterPill_Click" 
                                    Tag="App" 
                                    Margin="0,7,0,0"
                                    Style="{StaticResource FilterPillStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡ " FontSize="11" Foreground="{DynamicResource ShellBrush}"/>
                                    <TextBlock x:Name="FilterCountApp" Text="Apps (0)"/>
                                </StackPanel>
                            </Button>
                            <Border x:Name="PillShortcutApp" Style="{StaticResource PillCtrlBadgeStyle}" Visibility="Collapsed">
                                <TextBlock Text="Ctrl+2" Style="{StaticResource PillCtrlBadgeTextStyle}"/>
                            </Border>
                        </Grid>

                        <!-- Filter Pill: Snippets -->
                        <Grid ClipToBounds="False" Margin="0,0,12,0">
                            <Button x:Name="FilterPillSnippet" 
                                    Click="FilterPill_Click" 
                                    Tag="Snippet" 
                                    Margin="0,7,0,0"
                                    Style="{StaticResource FilterPillStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📝 " FontSize="11" Foreground="{DynamicResource SnippetBrush}"/>
                                    <TextBlock x:Name="FilterCountSnippet" Text="Snippets (0)"/>
                                </StackPanel>
                            </Button>
                            <Border x:Name="PillShortcutSnippet" Style="{StaticResource PillCtrlBadgeStyle}" Visibility="Collapsed">
                                <TextBlock Text="Ctrl+3" Style="{StaticResource PillCtrlBadgeTextStyle}"/>
                            </Border>
                        </Grid>

                        <!-- Filter Pill: Workflows -->
                        <Grid ClipToBounds="False" Margin="0,0,12,0">
                            <Button x:Name="FilterPillWorkflow" 
                                    Click="FilterPill_Click" 
                                    Tag="Workflow" 
                                    Margin="0,7,0,0"
                                    Style="{StaticResource FilterPillStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔀 " FontSize="11" Foreground="{DynamicResource WorkflowBrush}"/>
                                    <TextBlock x:Name="FilterCountWorkflow" Text="Workflows (0)"/>
                                </StackPanel>
                            </Button>
                            <Border x:Name="PillShortcutWorkflow" Style="{StaticResource PillCtrlBadgeStyle}" Visibility="Collapsed">
                                <TextBlock Text="Ctrl+4" Style="{StaticResource PillCtrlBadgeTextStyle}"/>
                            </Border>
                        </Grid>

                        <!-- Filter Pill: Folders -->
                        <Grid ClipToBounds="False" Margin="0,0,12,0">
                            <Button x:Name="FilterPillFolder" 
                                    Click="FilterPill_Click" 
                                    Tag="Folder" 
                                    Margin="0,7,0,0"
                                    Style="{StaticResource FilterPillStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁 " FontSize="11" Foreground="{DynamicResource FolderBrush}"/>
                                    <TextBlock x:Name="FilterCountFolder" Text="Folders (0)"/>
                                </StackPanel>
                            </Button>
                            <Border x:Name="PillShortcutFolder" Style="{StaticResource PillCtrlBadgeStyle}" Visibility="Collapsed">
                                <TextBlock Text="Ctrl+5" Style="{StaticResource PillCtrlBadgeTextStyle}"/>
                            </Border>
                        </Grid>

                        <!-- Filter Pill: Services -->
                        <Grid ClipToBounds="False" Margin="0,0,12,0">
                            <Button x:Name="FilterPillService" 
                                    Click="FilterPill_Click" 
                                    Tag="Service" 
                                    Margin="0,7,0,0"
                                    Style="{StaticResource FilterPillStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️ " FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock x:Name="FilterCountService" Text="Services (0)"/>
                                </StackPanel>
                            </Button>
                            <Border x:Name="PillShortcutService" Style="{StaticResource PillCtrlBadgeStyle}" Visibility="Collapsed">
                                <TextBlock Text="Ctrl+6" Style="{StaticResource PillCtrlBadgeTextStyle}"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Row 2: Results List & Empty State View -->
            <Grid Grid.Row="2">
                <!-- Results List -->
                <ListBox x:Name="ResultsListBox"
                         MinHeight="100"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionMode="Single"
                         SelectionChanged="ResultsListBox_SelectionChanged"
                         MouseDoubleClick="ResultsListBox_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,1.5"/>
                            <Setter Property="Focusable" Value="{Binding IsSelectable}"/>
                            <Setter Property="IsEnabled" Value="{Binding IsSelectable}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="itemBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="8,6"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource ItemSelectedBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- Mode A: Discreet Section Header -->
                                <Border Visibility="{Binding HeaderVisibility}" 
                                        Padding="4,6,4,3" 
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="{Binding HeaderBorderThickness}"
                                        Opacity="0.85">
                                    <TextBlock Text="{Binding SectionHeaderText}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                 </Border>

                                 <!-- Mode B: Standard Interactive Action Row -->
                                 <Grid Visibility="{Binding ActionVisibility}">
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="Auto"/> <!-- Left Icon -->
                                         <ColumnDefinition Width="*"/>    <!-- Name & Description -->
                                         <ColumnDefinition Width="Auto"/> <!-- Right Badges & Metadata -->
                                     </Grid.ColumnDefinitions>

                                     <!-- Left Action Icon -->
                                     <TextBlock Grid.Column="0"
                                                Text="{Binding IconSymbol}"
                                                FontSize="14"
                                                Width="24"
                                                VerticalAlignment="Center"
                                                Foreground="{Binding IconBrush}"/>

                                     <!-- Center: Highlighted Title & Detail -->
                                     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,10,0">
                                         <!-- Title with Character Highlight Support -->
                                         <TextBlock local:TextBlockInlines.Segments="{Binding HighlightedNameSegments}"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                    TextTrimming="CharacterEllipsis"/>

                                         <!-- Secondary Detail / Description (Clickable in calc mode to explore units) -->
                                         <TextBlock Text="{Binding SecondaryDetail}"
                                                    FontSize="11"
                                                    LineHeight="15"
                                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                                    TextWrapping="Wrap"
                                                    MaxHeight="36"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="{Binding HasSecondaryDetail}"
                                                    Margin="0,1,0,0"
                                                    Cursor="{Binding SubtitleCursor}"
                                                    ToolTip="{Binding SubtitleTooltip}"
                                                    PreviewMouseLeftButtonUp="SecondaryDetail_PreviewMouseLeftButtonUp"/>

                                         <!-- Alternative Units Micro-Pills (Calculator Mode) -->
                                         <StackPanel Orientation="Horizontal" 
                                                     Visibility="{Binding AlternativesVisibility}" 
                                                     Margin="0,4,0,0"
                                                     VerticalAlignment="Center">
                                             <ItemsControl ItemsSource="{Binding CommonAlternatives}">
                                                 <ItemsControl.ItemsPanel>
                                                     <ItemsPanelTemplate>
                                                         <StackPanel Orientation="Horizontal"/>
                                                     </ItemsPanelTemplate>
                                                 </ItemsControl.ItemsPanel>
                                                 <ItemsControl.ItemTemplate>
                                                     <DataTemplate>
                                                         <Button Style="{StaticResource CalcUnitPillButtonStyle}"
                                                                 Click="CalcUnitPill_Click"
                                                                 ToolTip="{Binding Description, StringFormat='Click to copy ({0})'}"
                                                                 Margin="0,0,5,0">
                                                             <TextBlock Text="{Binding FormattedValue}"/>
                                                         </Button>
                                                     </DataTemplate>
                                                 </ItemsControl.ItemTemplate>
                                             </ItemsControl>

                                             <!-- More Units Flyout Trigger Button -->
                                             <Button Style="{StaticResource CalcMoreUnitsButtonStyle}"
                                                     Click="CalcMoreUnitsBtn_Click"
                                                     ToolTip="Explore all alternative units (physics, comical, astronomical)">
                                                 <TextBlock Text="More Units... ▾"/>
                                             </Button>
                                         </StackPanel>
                                     </StackPanel>

                                     <!-- Right Column: Breadcrumbs, Recency, Type Badge, Hotkey -->
                                     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                         <!-- Folder Breadcrumb -->
                                         <TextBlock Text="{Binding FolderBreadcrumb}"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    Margin="0,0,8,0"
                                                    Visibility="{Binding HasFolderBreadcrumb}"
                                                    VerticalAlignment="Center"/>

                                         <!-- Usage Recency / Launch Count -->
                                         <TextBlock Text="{Binding UsageRecencyText}"
                                                    FontSize="10.5"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    Margin="0,0,8,0"
                                                    Visibility="{Binding HasUsageRecency}"
                                                    VerticalAlignment="Center"/>

                                         <!-- Action Type Micro-Badge -->
                                         <Border CornerRadius="4"
                                                 BorderThickness="1"
                                                 BorderBrush="{Binding TypeBorderBrush}"
                                                 Background="{Binding TypeBackgroundBrush}"
                                                 Padding="5,1.5"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center">
                                             <TextBlock Text="{Binding TypeText}"
                                                        FontSize="9.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding TypeForegroundBrush}"/>
                                         </Border>

                                         <!-- Admin Elevation Micro-Badge -->
                                         <Border CornerRadius="4"
                                                 BorderThickness="1"
                                                 BorderBrush="#E5A93C"
                                                 Background="#22E5A93C"
                                                 Padding="5,1.5"
                                                 Margin="0,0,6,0"
                                                 ToolTip="Runs with elevated Windows Administrator privileges"
                                                 Visibility="{Binding AdminBadgeVisibility}"
                                                 VerticalAlignment="Center">
                                             <TextBlock Text="🛡 Admin"
                                                        FontSize="9.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="#E5A93C"/>
                                         </Border>

                                         <!-- Folder Drill-Down Chevron (Clickable for mouse users) -->
                                         <Button Visibility="{Binding IsFolder}"
                                                 Click="FolderChevron_Click"
                                                 ToolTip="Drill into folder"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="4,1"
                                                 Cursor="Hand"
                                                 VerticalAlignment="Center">
                                             <TextBlock Text="›" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                         </Button>

                                         <!-- Global Hotkey Badge (if configured) -->
                                         <Border Style="{DynamicResource KeyBadgeStyle}"
                                                 Visibility="{Binding HasHotkey}"
                                                 VerticalAlignment="Center">
                                             <TextBlock Text="{Binding HotkeyText}"
                                                        FontSize="10"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"/>
                                         </Border>
                                     </StackPanel>
                                 </Grid>
                             </Grid>
                         </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty State Card (0 Matches or Empty Scoped Folder) -->
                <Border x:Name="EmptyStateCard"
                        Background="{DynamicResource BgInputBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24,18"
                        Margin="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="EmptyStateIconText" Text="🔍" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock x:Name="EmptyStateTitleText" Text="No matching actions found." 
                                   FontSize="13.5" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyStatePromptText"
                                   Text="Press Enter to create a new action"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,12"/>
                        <Button x:Name="CreateActionEmptyBtn"
                                Click="CreateActionEmptyBtn_Click"
                                Cursor="Hand"
                                Padding="12,6"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource AccentBrush}"
                                BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CreateActionEmptyBtnText" Text="➕ Create Action" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Calculator & Arithmetic Reference Guide (Shown when query starts with '=' or '@calc' with 0 results) -->
                <Border x:Name="CalculatorGuideCard"
                        Background="{DynamicResource BgInputBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12"
                        Margin="12,4"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Live Result or Draft Formula Banner -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <!-- State A: Valid Calculation Result Banner -->
                            <Border x:Name="CalcResultBanner"
                                    Background="{DynamicResource BgTertiaryBrush}"
                                    BorderBrush="{DynamicResource AccentSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,7"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Result & Description -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock x:Name="CalcResultValueText" 
                                                   Text="136" 
                                                   FontSize="17" 
                                                   FontWeight="Bold" 
                                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="CalcResultDescText" 
                                                   Text="Calculation result" 
                                                   FontSize="11" 
                                                   LineHeight="15"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                                   Margin="0,2,0,0" 
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Right: Quick Action Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Button x:Name="CalcResultPasteBtn" 
                                                Style="{StaticResource CalcUnitActionButtonStyle}" 
                                                Click="CalcResultPasteBtn_Click" 
                                                ToolTip="Paste answer into active window (Shift+Enter)" 
                                                Width="28" Height="26" Padding="0" Margin="0,0,4,0">
                                            <TextBlock Text="↵" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                        <Button x:Name="CalcResultCopyValueBtn" 
                                                Style="{StaticResource CalcUnitActionButtonStyle}" 
                                                Click="CalcResultCopyValueBtn_Click" 
                                                ToolTip="Copy answer to clipboard (Enter / Ctrl+C)" 
                                                Width="28" Height="26" Padding="0" Margin="0,0,4,0">
                                            <TextBlock Text="📋" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                        <Button x:Name="CalcResultCopyFullBtn" 
                                                Style="{StaticResource CalcUnitActionButtonStyle}" 
                                                Click="CalcResultCopyFullBtn_Click" 
                                                ToolTip="Copy equation and answer to clipboard (Ctrl+Shift+C)" 
                                                Width="28" Height="26" Padding="0" Margin="0,0,4,0">
                                            <TextBlock Text="💬" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                        <Button x:Name="CalcResultChainBtn" 
                                                Style="{StaticResource CalcUnitActionButtonStyle}" 
                                                Click="CalcResultChainBtn_Click" 
                                                ToolTip="Chain answer back into calculator (Tab)" 
                                                Width="28" Height="26" Padding="0" Margin="0,0,4,0">
                                            <TextBlock Text="⇥" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                        <Button x:Name="CalcResultMoreUnitsBtn" 
                                                Style="{StaticResource CalcMoreUnitsButtonStyle}" 
                                                Click="CalcResultMoreUnitsBtn_Click" 
                                                ToolTip="Explore all alternative units &amp; formats" 
                                                Visibility="Collapsed" 
                                                Height="26" Padding="7,2">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Units" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Text=" ▾" FontSize="9" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- State B: Draft Formula / Incomplete Input Banner -->
                            <Border x:Name="CalcDraftBanner"
                                    Background="{DynamicResource BgTertiaryBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,7"
                                    Visibility="Visible">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="CalcDraftTitleText" 
                                                       Text="🧮 Calculator Mode" 
                                                       FontSize="13.5" 
                                                       FontWeight="Bold" 
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4" Background="{DynamicResource AccentSubtleBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="Active Mode" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="CalcDraftSubtitleText" 
                                                   Text="Enter math expressions, dates (next friday, now + 3d), or unit conversions" 
                                                   FontSize="11" 
                                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" 
                                               Text="Click keypad below to insert" 
                                               FontSize="10.5" 
                                               Foreground="{DynamicResource TextMutedBrush}" 
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Category Tabs Strip -->
                        <WrapPanel Grid.Row="1" x:Name="CalcGuideTabsPanel" Margin="0,0,0,6">
                            <Button x:Name="CalcTabPopular" Content="🌟 Popular" Style="{StaticResource CalcGuideTabButtonStyle}" Click="CalcGuideTab_Click" Tag="Popular"/>
                            <Button x:Name="CalcTabDate" Content="📅 Date &amp; Time" Style="{StaticResource CalcGuideTabButtonStyle}" Click="CalcGuideTab_Click" Tag="Date"/>
                            <Button x:Name="CalcTabScientific" Content="📐 Scientific" Style="{StaticResource CalcGuideTabButtonStyle}" Click="CalcGuideTab_Click" Tag="Scientific"/>
                            <Button x:Name="CalcTabProgrammer" Content="💻 Programmer" Style="{StaticResource CalcGuideTabButtonStyle}" Click="CalcGuideTab_Click" Tag="Programmer"/>
                            <Button x:Name="CalcTabUnits" Content="📏 Units" Style="{StaticResource CalcGuideTabButtonStyle}" Click="CalcGuideTab_Click" Tag="Units"/>
                        </WrapPanel>

                        <!-- Delineation Line between Tabs and Content -->
                        <Border Grid.Row="2" Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,10"/>

                        <!-- Panels Scroll Container -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- 1. POPULAR PANEL -->
                                <StackPanel x:Name="CalcPanelPopular" Visibility="Visible">
                                    <!-- Tier 1: Quick Operators Bar -->
                                    <TextBlock Text="QUICK OPERATORS &amp; FUNCTIONS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,5"/>
                                    <WrapPanel Margin="0,0,0,10">
                                        <Button Content="+" Style="{StaticResource CalcKeypadButtonStyle}" Tag="+" Click="CalcOperatorButton_Click" ToolTip="Add"/>
                                        <Button Content="-" Style="{StaticResource CalcKeypadButtonStyle}" Tag="-" Click="CalcOperatorButton_Click" ToolTip="Subtract"/>
                                        <Button Content="*" Style="{StaticResource CalcKeypadButtonStyle}" Tag="*" Click="CalcOperatorButton_Click" ToolTip="Multiply"/>
                                        <Button Content="/" Style="{StaticResource CalcKeypadButtonStyle}" Tag="/" Click="CalcOperatorButton_Click" ToolTip="Divide"/>
                                        <Button Content="%" Style="{StaticResource CalcKeypadButtonStyle}" Tag="%" Click="CalcOperatorButton_Click" ToolTip="Percentage"/>
                                        <Button Content="now" Style="{StaticResource CalcKeypadButtonStyle}" Tag="now" Click="CalcOperatorButton_Click" ToolTip="Current timestamp"/>
                                        <Button Content="today" Style="{StaticResource CalcKeypadButtonStyle}" Tag="today" Click="CalcOperatorButton_Click" ToolTip="Today's date"/>
                                        <Button Content="sqrt()" Style="{StaticResource CalcKeypadButtonStyle}" Tag="sqrt()" Click="CalcOperatorButton_Click" ToolTip="Square root"/>
                                        <Button Content="to hex" Style="{StaticResource CalcKeypadButtonStyle}" Tag="to hex" Click="CalcOperatorButton_Click" ToolTip="Convert to hexadecimal"/>
                                        <Button Content="px to rem" Style="{StaticResource CalcKeypadButtonStyle}" Tag="px to rem" Click="CalcOperatorButton_Click" ToolTip="Convert CSS px to rem"/>
                                    </WrapPanel>

                                    <!-- Tier 2: Structured Examples with Descriptions -->
                                    <TextBlock Text="COMMON EXAMPLES &amp; DESCRIPTIONS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
