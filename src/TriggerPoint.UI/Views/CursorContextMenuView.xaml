<Window x:Class="TriggerPoint.UI.Views.CursorContextMenuView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TriggerPoint Context Menu"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown">

    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="8"
            MinWidth="260"
            MaxWidth="360">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45" Direction="270"/>
        </Border.Effect>

        <Grid Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Optional Title/Folder header -->
            <Border Grid.Row="0" x:Name="HeaderBorder" Padding="8,4,8,6" Visibility="Collapsed">
                <TextBlock x:Name="HeaderTitleText" 
                           FontSize="11" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource TextMutedBrush}"/>
            </Border>

            <!-- Items List -->
            <ItemsControl Grid.Row="1" x:Name="ItemsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="5"
                                Padding="8,6"
                                Margin="0,1"
                                Cursor="Hand"
                                MouseLeftButtonUp="ItemBorder_MouseLeftButtonUp">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Accelerator badge or icon -->
                                <Border Grid.Column="0" 
                                        Style="{StaticResource KeyBadgeStyle}"
                                        Width="22" Height="22"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasAccelerator, Converter={x:Null}}">
                                    <TextBlock Text="{Binding AcceleratorKey}" 
                                               FontSize="11" 
                                               FontWeight="Bold" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </Border>

                                <!-- Title and Description -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" 
                                               FontWeight="Medium" 
                                               FontSize="13" 
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Description}" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding HasDescription, Converter={x:Null}}"/>
                                </StackPanel>

                                <!-- Hotkey or Type Badge -->
                                <TextBlock Grid.Column="2" 
                                           Text="{Binding TypeBadge}" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Keyboard shortcut hint footer -->
            <Border Grid.Row="2" 
                    BorderBrush="{DynamicResource BorderSubtleBrush}" 
                    BorderThickness="0,1,0,0" 
                    Margin="4,6,4,2" 
                    Padding="4,4,4,0">
                <TextBlock Text="⏎ Run  •  Ctrl+⏎ Admin  •  Shift+⏎ Reveal  •  Alt+⏎ Edit"
                           FontSize="10"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
