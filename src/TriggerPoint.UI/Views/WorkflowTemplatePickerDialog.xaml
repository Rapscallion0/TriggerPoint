<Window x:Class="TriggerPoint.UI.Views.WorkflowTemplatePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workflow Templates"
        Width="720" Height="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.4" Direction="270"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Search & Filter Toolbar -->
                <RowDefinition Height="*"/>    <!-- Templates List -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Workflow Templates" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Select a starter template to populate this workflow or manage templates" 
                               FontSize="12" 
                               Foreground="{DynamicResource TextSecondaryBrush}" 
                               Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" 
                        Content="✕" 
                        Style="{StaticResource WindowControlButtonStyle}" 
                        Width="28" Height="28" 
                        Click="CancelBtn_Click"/>
            </Grid>

            <!-- Search & Filter Toolbar -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <TextBox Grid.Column="0" 
                         x:Name="SearchBox" 
                         Style="{StaticResource ModernTextBoxStyle}" 
                         Height="34" 
                         Margin="0,0,8,0"
                         Tag="Search templates by title, category, or description..." 
                         TextChanged="SearchBox_TextChanged"/>

                <!-- Category Filter -->
                <ComboBox Grid.Column="1" 
                          x:Name="CategoryFilterBox" 
                          Width="170" 
                          Height="34" 
                          Margin="0,0,8,0"
                          SelectionChanged="CategoryFilterBox_SelectionChanged"/>

                <!-- New Template Button -->
                <Button Grid.Column="2" 
                        x:Name="NewTemplateBtn" 
                        Content="+ New" 
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Height="34" 
                        Padding="12,0" 
                        Margin="0,0,6,0"
                        ToolTip="Create a new workflow template from scratch" 
                        Click="NewTemplateBtn_Click"/>

                <!-- Open Folder Button -->
                <Button Grid.Column="3" 
                        x:Name="OpenFolderBtn" 
                        Content="📁 Open Folder" 
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Height="34" 
                        Padding="10,0" 
                        ToolTip="Open templates folder in Windows Explorer" 
                        Click="OpenFolderBtn_Click"/>
            </Grid>

            <!-- Templates List -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource BgPrimaryBrush}" 
                    BorderBrush="{DynamicResource BorderSubtleBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="6" 
                    Margin="0,0,0,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TemplatesHost"/>
                </ScrollViewer>
            </Border>

            <!-- Footer -->
            <Grid Grid.Row="3">
                <TextBlock x:Name="StatusCountText" 
                           Text="Showing 0 templates" 
                           FontSize="11" 
                           Foreground="{DynamicResource TextSecondaryBrush}" 
                           VerticalAlignment="Center"/>
                <Button Content="Close" 
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Width="85" Height="32" 
                        HorizontalAlignment="Right" 
                        Click="CancelBtn_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
