<Window x:Class="TriggerPoint.UI.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Accent Color"
        Width="570" Height="410"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" Direction="270"/>
        </Border.Effect>

        <Grid Margin="18,14,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 12,3 A 9,9 0 0 0 3,12 C 3,14.5 5,16.5 7.5,16.5 H 8.7 C 9.3,16.5 9.7,17 9.7,17.5 C 9.7,17.7 9.6,18 9.5,18.2 C 8.9,19.3 9.7,21 11,21 H 12 A 9,9 0 0 0 21,12 C 21,7 17,3 12,3 Z M 6.5,12 C 5.7,12 5,11.3 5,10.5 C 5,9.7 5.7,9 6.5,9 C 7.3,9 8,9.7 8,10.5 C 8,11.3 7.3,12 6.5,12 Z M 9.5,8 C 8.7,8 8,7.3 8,6.5 C 8,5.7 8.7,5 9.5,5 C 10.3,5 11,5.7 11,6.5 C 11,7.3 10.3,8 9.5,8 Z M 14.5,8 C 13.7,8 13,7.3 13,6.5 C 13,5.7 13.7,5 14.5,5 C 15.3,5 16,5.7 16,6.5 C 16,7.3 15.3,8 14.5,8 Z M 17.5,12 C 16.7,12 16,11.3 16,10.5 C 16,9.7 16.7,9 17.5,9 C 18.3,9 19,9.7 19,10.5 C 19,11.3 18.3,12 17.5,12 Z"
                          Fill="{DynamicResource AccentBrush}"
                          Width="16" Height="16"
                          Stretch="Uniform"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"/>
                    <TextBlock Text="Choose Accent Color"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="✕"
                        Style="{StaticResource WindowControlButtonStyle}"
                        Width="26" Height="26"
                        FontSize="11"
                        Click="CloseButton_Click"/>
            </Grid>

            <!-- Main Content: Left Panel (Palettes) and Right Panel (Spectrum & Controls) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="235"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Basic & Custom Colors -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Basic colors:"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,6"/>

                    <!-- 48 Basic Colors Grid (8 cols x 6 rows) -->
                    <Border Background="{DynamicResource BgTertiaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="3"
                            Margin="0,0,0,10">
                        <UniformGrid x:Name="BasicColorsGrid" Columns="8" Rows="6"/>
                    </Border>

                    <TextBlock Text="Custom colors:"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,6"/>

                    <!-- 16 Custom Colors Grid (8 cols x 2 rows) -->
                    <Border Background="{DynamicResource BgTertiaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="3"
                            Margin="0,0,0,10">
                        <UniformGrid x:Name="CustomColorsGrid" Columns="8" Rows="2"/>
                    </Border>

                    <!-- Add to Custom Colors Button -->
                    <Button x:Name="AddToCustomColorsBtn"
                            Content="Add to Custom Colors"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Padding="0,5"
                            FontSize="11.5"
                            Cursor="Hand"
                            Click="AddToCustomColorsBtn_Click"/>
                </StackPanel>

                <!-- Vertical Divider -->
                <Rectangle Grid.Column="1"
                           Width="1"
                           Fill="{DynamicResource BorderSubtleBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,2"/>

                <!-- Right Panel: 2D Spectrum, Lum Slider, Previews & Values -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="165"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: 2D Hue/Sat Spectrum and Lum Slider -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>

                        <!-- 2D Spectrum Canvas -->
                        <Border Grid.Column="0"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                ClipToBounds="True">
                            <Grid x:Name="SpectrumGrid"
                                  Background="Transparent"
                                  MouseLeftButtonDown="Spectrum_MouseDown"
                                  MouseMove="Spectrum_MouseMove"
                                  MouseLeftButtonUp="Spectrum_MouseUp">
                                <Image x:Name="SpectrumImage" Stretch="Fill"/>
                                <Canvas x:Name="SpectrumCanvas" IsHitTestVisible="False">
                                    <Ellipse x:Name="SpectrumReticle"
                                             Width="12" Height="12"
                                             Stroke="White"
                                             StrokeThickness="2"
                                             Margin="-6,-6,0,0">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.8" Color="Black"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Canvas>
                            </Grid>
                        </Border>

                        <!-- Luminosity Slider Bar & Arrow -->
                        <Grid Grid.Column="2"
                              Background="Transparent"
                              Cursor="SizeNS"
                              MouseLeftButtonDown="LumBar_MouseDown"
                              MouseMove="LumBar_MouseMove"
                              MouseLeftButtonUp="LumBar_MouseUp">
                            <Border x:Name="LumBar"
                                    Width="16" Height="163"
                                    CornerRadius="3"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left"
                                    IsHitTestVisible="False"/>
                            <Canvas x:Name="LumCanvas" IsHitTestVisible="False">
                                <Polygon x:Name="LumPointer"
                                         Points="7,0 0,5 7,10"
                                         Fill="{DynamicResource TextPrimaryBrush}"
                                         Margin="18,-5,0,0"/>
                            </Canvas>
                        </Grid>
                    </Grid>

                    <!-- Row 1: Preview Swatch + Channel Inputs -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Preview & Dropper -->
                        <StackPanel Grid.Column="0">
                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    ClipToBounds="True">
                                <StackPanel>
                                    <Border x:Name="NewColorPreview"
                                            Height="28"
                                            Background="#8B5CF6"
                                            ToolTip="New selected color"/>
                                    <Border x:Name="OriginalColorPreview"
                                            Height="28"
                                            Background="#8B5CF6"
                                            Cursor="Hand"
                                            ToolTip="Original color (click to restore)"
                                            MouseLeftButtonUp="OriginalColorPreview_Click"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="EyeDropperBtn"
                                    ToolTip="Pick color from screen (Arrow keys: 1px nudging, Shift+Arrows: 10px, Enter: confirm)"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="24"
                                    Margin="0,6,0,0"
                                    Padding="0"
                                    Cursor="Hand"
                                    Click="EyeDropperBtn_Click">
                                <Path Data="M 20.71,5.63 L 18.37,3.29 C 17.98,2.9 17.35,2.9 16.96,3.29 L 13.84,6.41 L 11.91,4.5 L 10.5,5.91 L 11.92,7.33 L 3,16.25 L 3,21 L 7.75,21 L 16.67,12.08 L 18.09,13.5 L 19.5,12.09 L 17.58,10.17 L 20.7,7.05 C 21.1,6.65 21.1,6.02 20.71,5.63 Z M 6.92,19 L 5,17.08 L 13.06,9.02 L 14.98,10.94 L 6.92,19 Z"
                                      Fill="{DynamicResource TextPrimaryBrush}"
                                      Width="13" Height="13"
                                      Stretch="Uniform"/>
                            </Button>
                        </StackPanel>

                        <!-- Numerical Inputs Grid -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Hex Input -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Hex:"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,4"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4"
                                     x:Name="HexInput"
                                     Height="22"
                                     FontSize="11"
                                     FontFamily="Cascadia Code, Consolas, Courier New"
                                     FontWeight="SemiBold"
                                     VerticalContentAlignment="Center"
                                     Padding="3,0"
                                     Background="{DynamicResource BgInputBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     MaxLength="7"
                                     Margin="0,0,0,4"
                                     TextChanged="HexInput_TextChanged"/>

                            <!-- Hue & Red -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Hue:" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,3"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="HueInput" Height="20" FontSize="10.5" VerticalContentAlignment="Center" Padding="2,0" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,3" TextChanged="HslInput_TextChanged"/>

                            <TextBlock Grid.Row="1" Grid.Column="3" Text="Red:" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,3"/>
                            <TextBox Grid.Row="1" Grid.Column="4" x:Name="RedInput" Height="20" FontSize="10.5" VerticalContentAlignment="Center" Padding="2,0" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,3" TextChanged="RgbInput_TextChanged"/>

                            <!-- Sat & Green -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Sat:" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,3"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="SatInput" Height="20" FontSize="10.5" VerticalContentAlignment="Center" Padding="2,0" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,3" TextChanged="HslInput_TextChanged"/>

                            <TextBlock Grid.Row="2" Grid.Column="3" Text="Green:" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,3"/>
                            <TextBox Grid.Row="2" Grid.Column="4" x:Name="GreenInput" Height="20" FontSize="10.5" VerticalContentAlignment="Center" Padding="2,0" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,3" TextChanged="RgbInput_TextChanged"/>

                            <!-- Lum & Blue -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Lum:" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="LumInput" Height="20" FontSize="10.5" VerticalContentAlignment="Center" Padding="2,0" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" TextChanged="HslInput_TextChanged"/>

                            <TextBlock Grid.Row="3" Grid.Column="3" Text="Blue:" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Grid.Row="3" Grid.Column="4" x:Name="BlueInput" Height="20" FontSize="10.5" VerticalContentAlignment="Center" Padding="2,0" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" TextChanged="RgbInput_TextChanged"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Action Footer -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn"
                            Content="Cancel (Esc)"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="14,5"
                            Margin="0,0,8,0"
                            Click="CancelBtn_Click"/>
                    <Button x:Name="OkBtn"
                            Content="OK (Enter)"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="16,5"
                            Click="OkBtn_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
