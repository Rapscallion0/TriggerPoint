<UserControl x:Class="TriggerPoint.UI.Controls.SearchableServicePickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="36" d:DesignWidth="400"
             Focusable="True"
             FocusVisualStyle="{x:Null}">

    <UserControl.Resources>
        <Style x:Key="ServiceListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                Margin="2,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <!-- Main Picker Closed Card / Button -->
        <Border x:Name="PickerCard"
                Background="{DynamicResource BgInputBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,5"
                MinHeight="36"
                Cursor="Hand"
                PreviewMouseLeftButtonDown="PickerCard_PreviewMouseLeftButtonDown"
                PreviewMouseLeftButtonUp="PickerCard_PreviewMouseLeftButtonUp">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding ElementName=ServicePickerPopup, Path=IsOpen}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="BorderThickness" Value="1.5"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Status / Service Emoji -->
                    <ColumnDefinition Width="*"/>    <!-- Text: Name + (Service) -->
                    <ColumnDefinition Width="Auto"/> <!-- Status Badge Pill -->
                    <ColumnDefinition Width="Auto"/> <!-- Clear Button -->
                    <ColumnDefinition Width="Auto"/> <!-- Chevron ▾ -->
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <TextBlock Grid.Column="0"
                           x:Name="IconText"
                           Text="⚙️"
                           FontSize="13"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>

                <!-- Primary Text & Secondary Text -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="DisplayNameBlock"
                               Text="Select or search Windows service..."
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ServiceNameBlock"
                               Text=""
                               FontSize="11.5"
                               Margin="6,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- Live Status Badge Pill -->
                <Border Grid.Column="2"
                        x:Name="StatusPillBorder"
                        Background="{DynamicResource AccentSubtleBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,2"
                        Margin="8,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock x:Name="StatusPillText"
                               Text="⚪ Unknown"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"/>
                </Border>

                <!-- Clear Selection Button -->
                <Button Grid.Column="3"
                        x:Name="ClearButton"
                        Content="✕"
                        Style="{DynamicResource WindowControlButtonStyle}"
                        Width="22" Height="22"
                        FontSize="11"
                        Padding="0"
                        Margin="0,0,6,0"
                        ToolTip="Clear selected service"
                        Click="ClearButton_Click"
                        Visibility="Collapsed"/>

                <!-- Dropdown Arrow Chevron -->
                <TextBlock Grid.Column="4"
                           Text="▾"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="4,0,2,0"/>
            </Grid>
        </Border>

        <!-- Dropdown Popup -->
        <Popup x:Name="ServicePickerPopup"
               PlacementTarget="{Binding ElementName=PickerCard}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Slide"
               Opened="ServicePickerPopup_Opened"
               Closed="ServicePickerPopup_Closed">
            <Border x:Name="PopupBorder"
                    MinWidth="{Binding ElementName=PickerCard, Path=ActualWidth}"
                    Width="480"
                    MaxHeight="360"
                    Background="{DynamicResource BgSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,4,0,0"
                    Padding="8"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.45" Direction="270"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search Box -->
                        <RowDefinition Height="*"/>    <!-- Filtered Results List -->
                        <RowDefinition Height="Auto"/> <!-- Manual / Custom Service Name Action -->
                        <RowDefinition Height="Auto"/> <!-- Footer / Count Info -->
                    </Grid.RowDefinitions>

                    <!-- Search Filter Box -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource BgInputBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,5"
                            Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="🔍"
                                       FontSize="12"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"/>

                            <TextBox Grid.Column="1"
                                     x:Name="SearchBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource AccentBrush}"
                                     FontSize="12.5"
                                     VerticalAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"
                                     KeyDown="SearchBox_KeyDown"/>

                            <!-- Watermark / Placeholder -->
                            <TextBlock Grid.Column="1"
                                       x:Name="SearchPlaceholder"
                                       Text="Type to filter (e.g. spool, docker, sql, update)..."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Margin="2,0,0,0"/>

                            <Button Grid.Column="2"
                                    x:Name="ClearSearchBtn"
                                    Content="✕"
                                    Style="{DynamicResource WindowControlButtonStyle}"
                                    Width="18" Height="18"
                                    FontSize="10"
                                    Padding="0"
                                    Click="ClearSearchBtn_Click"
                                    Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- Filtered Services List -->
                    <ListBox Grid.Row="1"
                             x:Name="ServicesListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource ServiceListItemStyle}"
                             MaxHeight="240"
                             SelectionChanged="ServicesListBox_SelectionChanged"
                             KeyDown="ServicesListBox_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Status Emoji -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding StatusBadgeEmoji}"
                                               FontSize="12"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>

                                    <!-- Names -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ServiceName}"
                                                   FontSize="11"
                                                   FontFamily="Consolas, Segoe UI Mono, monospace"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Startup & Status Text -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding StartType}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Custom / Manual Service Name Option (if query typed) -->
                    <Border Grid.Row="2"
                            x:Name="CustomServiceOptionBorder"
                            Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,5"
                            Margin="0,4,0,0"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            MouseLeftButtonDown="CustomServiceOption_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="✍️" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       x:Name="CustomServiceOptionText"
                                       Text="Use manual service name"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="Enter ↵"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Footer Info (Showing X of Y services) -->
                    <Grid Grid.Row="3" Margin="4,6,4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   x:Name="CountSummaryText"
                                   Text="Showing all services"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1"
                                   Text="Esc to close"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </Grid>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
