<Window x:Class="TriggerPoint.UI.Views.ServiceProgressHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Service Operation HUD"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Storyboard x:Key="SpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinnerTransform"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360"
                             Duration="0:0:1.0"/>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="HudContainer"
            Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1.5"
            CornerRadius="10"
            Margin="16"
            MinWidth="380"
            MaxWidth="560"
            Padding="16,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="#000000" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Spinner / Status Icon -->
            <Border Grid.Column="0"
                    x:Name="IconBadge"
                    Width="32" Height="32"
                    CornerRadius="16"
                    Background="{DynamicResource BgTertiaryBrush}"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="20" Height="20">
                    <!-- Vector Progress Ring -->
                    <Grid x:Name="SpinnerContainer" Width="20" Height="20" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="SpinnerTransform" Angle="0"/>
                        </Grid.RenderTransform>

                        <!-- Subtle circular background track -->
                        <Ellipse Width="18" Height="18"
                                 Stroke="{DynamicResource BorderBrush}"
                                 StrokeThickness="2.5"
                                 Opacity="0.35"/>

                        <!-- Active accent arc -->
                        <Path Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="2.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 10,1 A 9,9 0 0 1 19,10"/>
                    </Grid>

                    <!-- Status Icon (Shown upon Success / Error) -->
                    <TextBlock x:Name="StatusGlyph"
                               Text="✔"
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"
                               Foreground="{DynamicResource SuccessBrush}"/>
                </Grid>
            </Border>

            <!-- Details -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="TitleText"
                           Text="Windows Service"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="MessageText"
                           Text="Executing operation..."
                           FontSize="11.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Cancel Button -->
            <Button Grid.Column="2"
                    x:Name="CancelButton"
                    Content="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="12,4"
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Click="CancelButton_Click"/>
        </Grid>
    </Border>
</Window>
