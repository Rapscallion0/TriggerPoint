<Window x:Class="TriggerPoint.UI.Views.ServicePropertiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Service Properties"
        Width="540"
        MaxHeight="700"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.45" Direction="270"/>
        </Border.Effect>

        <Grid Margin="18,16,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar / Header -->
                <RowDefinition Height="Auto"/> <!-- Identity & Status Card -->
                <RowDefinition Height="Auto"/> <!-- Quick Action Buttons Bar -->
                <RowDefinition Height="*"/>    <!-- Details & Metadata -->
                <RowDefinition Height="Auto"/> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header & Close Button -->
            <Grid Grid.Row="0" Margin="0,0,0,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚙️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Service Properties"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="✕"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        FontSize="13"
                        FontWeight="Bold"
                        Padding="6,2"
                        Cursor="Hand"
                        Click="CloseBtn_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Row 1: Identity & Status Card -->
            <Border Grid.Row="1"
                    Background="{DynamicResource BgInputBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <!-- Display Name -->
                        <TextBlock x:Name="ServiceDisplayNameText"
                                   Text="Service Display Name"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- Service Key Name & Copy Button -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Service Key: " FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="ServiceNameText"
                                       Text="service_key"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       FontFamily="{DynamicResource CodeFont}"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <Button x:Name="CopyServiceNameBtn"
                                    Click="CopyServiceNameBtn_Click"
                                    ToolTip="Copy service key name"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Cursor="Hand"
                                    Padding="4,0"
                                    Margin="4,0,0,0">
                                <TextBlock Text="📋" FontSize="11"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Status Pill & Refresh -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="StatusPillBorder"
                                CornerRadius="5"
                                BorderThickness="1"
                                Padding="8,3"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusEmojiText" Text="🟢" FontSize="11" Margin="0,0,4,0"/>
                                <TextBlock x:Name="StatusLabelText" Text="Running" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="RefreshStatusBtn"
                                Click="RefreshStatusBtn_Click"
                                ToolTip="Refresh service status"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Padding="6,3"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="🔄" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 2: Control Action Buttons Bar -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BgInputBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Start, Stop, Restart buttons -->
                        <ColumnDefinition Width="*"/>    <!-- Live feedback text -->
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="StartBtn"
                                Click="StartBtn_Click"
                                Content="▶ Start"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                FontWeight="SemiBold"
                                FontSize="11"
                                Padding="10,4"
                                Margin="0,0,6,0"/>

                        <Button x:Name="StopBtn"
                                Click="StopBtn_Click"
                                Content="⏹ Stop"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                FontWeight="SemiBold"
                                FontSize="11"
                                Padding="10,4"
                                Margin="0,0,6,0"/>

                        <Button x:Name="RestartBtn"
                                Click="RestartBtn_Click"
                                Content="🔄 Restart"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                FontWeight="SemiBold"
                                FontSize="11"
                                Padding="10,4"/>
                    </StackPanel>

                    <!-- Feedback message -->
                    <TextBlock x:Name="ActionFeedbackText"
                               Grid.Column="1"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="12,0,0,0"/>
                </Grid>
            </Border>

            <!-- Row 3: Metadata Cards Container -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="320">
                <StackPanel>
                    <!-- Description Card -->
                    <Border Background="{DynamicResource BgInputBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="DESCRIPTION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="DescriptionText"
                                       Text="No description provided for this service."
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="16"/>
                        </StackPanel>
                    </Border>

                    <!-- Path to Executable Card -->
                    <Border Background="{DynamicResource BgInputBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="PATH TO EXECUTABLE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>

                            <TextBlock x:Name="BinaryPathText"
                                       Grid.Row="1" Grid.Column="0"
                                       Text="C:\Windows\System32\svchost.exe"
                                       FontSize="11"
                                       FontFamily="{DynamicResource CodeFont}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="RevealBinaryBtn"
                                        Click="RevealBinaryBtn_Click"
                                        Content="📁 Reveal"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        FontSize="10.5"
                                        Padding="7,2"
                                        Margin="4,0,0,0"
                                        ToolTip="Locate executable in Windows Explorer"/>
                                <Button x:Name="CopyBinaryPathBtn"
                                        Click="CopyBinaryPathBtn_Click"
                                        Content="📋 Copy"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        FontSize="10.5"
                                        Padding="7,2"
                                        Margin="4,0,0,0"
                                        ToolTip="Copy binary path to clipboard"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Service Properties 2-Column Grid -->
                    <Border Background="{DynamicResource BgInputBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Startup Type -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                <TextBlock Text="STARTUP TYPE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock x:Name="StartupTypeText" Text="Automatic" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <!-- Log On Account -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                <TextBlock Text="LOG ON AS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock x:Name="ServiceAccountText" Text="LocalSystem" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <!-- Process ID -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                <TextBlock Text="PROCESS ID (PID)" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock x:Name="ProcessIdText" Text="None" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <!-- Can Stop -->
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                                <TextBlock Text="ACCEPTS STOP CONTROL" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock x:Name="CanStopText" Text="Yes" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <!-- Can Pause / Continue -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="CAN PAUSE &amp; CONTINUE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock x:Name="CanPauseText" Text="No" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <!-- Can Shutdown -->
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="NOTIFIED ON SHUTDOWN" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock x:Name="CanShutdownText" Text="No" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Row 4: Footer Bar -->
            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="OpenServicesMscBtn"
                        Click="OpenServicesMscBtn_Click"
                        Content="Open Windows Services (services.msc) ↗"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        FontSize="11"
                        Padding="10,5"/>

                <Button Grid.Column="2"
                        Content="Close"
                        Style="{DynamicResource AccentButtonStyle}"
                        FontSize="11.5"
                        Padding="16,5"
                        Click="CloseBtn_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>

