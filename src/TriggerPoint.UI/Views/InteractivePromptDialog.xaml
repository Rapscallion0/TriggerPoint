<Window x:Class="TriggerPoint.UI.Views.InteractivePromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TriggerPoint — Input Parameters"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Direction="270"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Parameters Required"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Provide the values below to proceed with snippet execution."
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Dynamic Input Fields Container -->
            <ScrollViewer Grid.Row="1" MaxHeight="400" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="FieldsContainer" Margin="0,0,4,0"/>
            </ScrollViewer>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        Margin="0,18,0,0">
                <Button Content="Cancel (Esc)" 
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>
                <Button Content="Execute (Enter / Ctrl+Enter)" 
                        ToolTip="Execute snippet (Ctrl+Enter from any field, or Enter from single-line fields)"
                        Style="{StaticResource AccentButtonStyle}" 
                        Click="SubmitButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
