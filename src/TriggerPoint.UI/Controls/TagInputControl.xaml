<UserControl x:Class="TriggerPoint.UI.Controls.TagInputControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="400">
    <Border x:Name="ContainerBorder"
            Background="{DynamicResource BgInputBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="4,3"
            MinHeight="36"
            SnapsToDevicePixels="True"
            MouseLeftButtonDown="ContainerBorder_MouseLeftButtonDown">
        <WrapPanel x:Name="PillWrapPanel" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Dynamic Pills inserted via ItemsControl -->
            <ItemsControl x:Name="PillsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding PillBackground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                BorderBrush="{Binding PillBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="7,3"
                                Margin="2,2"
                                SnapsToDevicePixels="True"
                                MouseLeftButtonDown="PillBorder_MouseLeftButtonDown">
                            <Grid VerticalAlignment="Center">
                                <!-- Display View (Double Click to Edit) -->
                                <StackPanel Orientation="Horizontal" 
                                            VerticalAlignment="Center" 
                                            Visibility="{Binding DisplayVisibility}">
                                    <TextBlock Text="{Binding Icon}" 
                                               FontSize="11" 
                                               Margin="0,0,5,0" 
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Value}" 
                                               FontSize="12" 
                                               FontWeight="Medium" 
                                               Foreground="{Binding PillForeground, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                               VerticalAlignment="Center"
                                               ToolTip="Double-click to edit"/>
                                    <Button Content="✕" 
                                            Click="RemovePillBtn_Click"
                                            Tag="{Binding}"
                                            Width="16" Height="16"
                                            Margin="6,0,0,0"
                                            FontSize="10"
                                            Foreground="{Binding PillForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Opacity="0.7"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            ToolTip="Remove"
                                            VerticalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder" Background="Transparent" CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>

                                <!-- In-Place Inline Editor -->
                                <TextBox x:Name="PillEditBox"
                                         Text="{Binding EditingValue, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding EditVisibility}"
                                         Background="{DynamicResource BgSecondaryBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource AccentBrush}"
                                         BorderThickness="1"
                                         Padding="4,1"
                                         FontSize="12"
                                         MinWidth="70"
                                         VerticalAlignment="Center"
                                         KeyDown="PillEditBox_KeyDown"
                                         LostFocus="PillEditBox_LostFocus"
                                         Loaded="PillEditBox_Loaded"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Inline Input Box -->
            <Grid VerticalAlignment="Center" Margin="4,2" MinWidth="130">
                <TextBox x:Name="InlineInputBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                         FontSize="12.5"
                         VerticalAlignment="Center"
                         Padding="2"
                         KeyDown="InlineInputBox_KeyDown"
                         TextChanged="InlineInputBox_TextChanged"/>
                <TextBlock x:Name="PlaceholderBlock"
                           Text="Type and press Enter to add..."
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontStyle="Italic"
                           FontSize="12"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Padding="2,0,0,0"/>
            </Grid>
        </WrapPanel>
    </Border>
</UserControl>
