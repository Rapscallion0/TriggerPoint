<Window x:Class="TriggerPoint.UI.Views.ModernMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TriggerPoint"
        MinWidth="420"
        MaxWidth="540"
        Width="Auto"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.45" Direction="270"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with Icon & Title -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock x:Name="DialogIconText" 
                           Text="❓" 
                           FontSize="20" 
                           Margin="0,0,10,0" 
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="DialogTitleText" 
                           Text="Confirm Action" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource TextPrimaryBrush}" 
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Message Body -->
            <TextBlock Grid.Row="1"
                       x:Name="DialogMessageText"
                       Text="Are you sure you want to proceed?"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,18"
                       LineHeight="19"/>

            <!-- Buttons Row -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="AlternateBtn"
                        Grid.Column="0"
                        Content="Move to Root &amp; Delete Folder"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Visibility="Collapsed"
                        Click="AlternateBtn_Click"/>

                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <Button x:Name="SecondaryBtn" 
                            Content="Cancel" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Margin="0,0,8,0"
                            Click="SecondaryBtn_Click"/>
                    <Button x:Name="PrimaryBtn" 
                            Content="Confirm" 
                            Style="{StaticResource AccentButtonStyle}" 
                            Click="PrimaryBtn_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
