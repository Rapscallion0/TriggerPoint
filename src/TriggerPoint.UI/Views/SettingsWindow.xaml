<Window x:Class="TriggerPoint.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TriggerPoint.UI.Controls"
        Title="TriggerPoint — Precision Shortcuts &amp; Launcher Settings"
        Icon="/Assets/TriggerPoint.ico"
        Width="960" Height="650"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        Background="{DynamicResource BgPrimaryBrush}"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Custom Title Bar Toolbar -->
        <Border Grid.Row="0" 
                Background="{DynamicResource BgSecondaryBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="16,8,8,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                    <StackPanel>
                        <TextBlock Text="TriggerPoint" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Precision shortcuts. Instant menus. Zero bloat." FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Actions Toolbar -->
                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="SnoozeToggleBtn"
                            Content="🔔 Active" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Margin="0,0,8,0"
                            ToolTip="Toggle global hotkeys snooze mode"
                            Click="SnoozeToggleBtn_Click"/>

                    <Button Content="💾 Save &amp; Apply" 
                            Style="{StaticResource AccentButtonStyle}" 
                            Margin="0,0,8,0"
                            ToolTip="Save all changes to disk and register hotkeys with Windows"
                            Click="SaveBtn_Click"/>

                    <Button Content="⚙ Settings" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Margin="0,0,16,0"
                            ToolTip="Open Application Settings (Log Level, Log Retention, Theme, Startup)"
                            Click="AppSettingsBtn_Click"/>
                </StackPanel>

                <!-- Custom Window System Buttons -->
                <StackPanel Grid.Column="3" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" 
                            Style="{StaticResource WindowControlButtonStyle}" 
                            ToolTip="Minimize"
                            Click="WindowMinimize_Click"/>
                    <Button x:Name="MaximizeBtn" 
                            Content="▢" 
                            Style="{StaticResource WindowControlButtonStyle}" 
                            ToolTip="Maximize or Restore"
                            Click="WindowMaximize_Click"/>
                    <Button Content="✕" 
                            Style="{StaticResource WindowCloseButtonStyle}" 
                            ToolTip="Close (Minimizes to Tray)"
                            Click="WindowClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Master-Detail Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260" MaxWidth="450"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Master Pane: TreeView of Items -->
            <Grid Grid.Column="0" Background="{DynamicResource BgSecondaryBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tree Header: Search & Add Dropdown -->
                <Grid Grid.Row="0" Margin="12,10,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             x:Name="TreeSearchBox"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Height="32"
                             Tag="Search actions..."
                             ToolTip="Filter shortcuts and folders by name or description"
                             TextChanged="TreeSearchBox_TextChanged"/>

                    <Button Grid.Column="1"
                            x:Name="AddMenuBtn"
                            Content="+"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="32" Height="32"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Padding="0"
                            Margin="6,0,0,0"
                            ToolTip="Add item or folder"
                            Click="AddMenuBtn_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="AddButtonContextMenu">
                                <MenuItem Header="New Action" Click="AddActionBtn_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="⚡" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="New Folder" Click="AddFolderBtn_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="📁" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <!-- TreeView -->
                <TreeView Grid.Row="1"
                          x:Name="ItemsTreeView"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="8,4"
                          AllowDrop="True"
                          PreviewMouseLeftButtonDown="ItemsTreeView_PreviewMouseLeftButtonDown"
                          PreviewMouseRightButtonDown="ItemsTreeView_PreviewMouseRightButtonDown"
                          MouseMove="ItemsTreeView_MouseMove"
                          DragOver="ItemsTreeView_DragOver"
                          Drop="ItemsTreeView_Drop"
                          PreviewKeyDown="ItemsTreeView_PreviewKeyDown"
                          SelectedItemChanged="ItemsTreeView_SelectedItemChanged">
                    <TreeView.ContextMenu>
                        <ContextMenu x:Name="TreeContextMenu" Opened="TreeContextMenu_Opened">
                            <MenuItem x:Name="ContextAddActionItem" Header="New Action" Click="AddActionBtn_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="⚡" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ContextAddFolderItem" Header="New Folder" Click="AddFolderBtn_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="📁" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator x:Name="ContextDeleteSeparator"/>
                            <MenuItem x:Name="ContextDeleteItem" Header="Delete" InputGestureText="Del" Click="DeleteItemBtn_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="🗑" FontSize="13" Foreground="{DynamicResource ErrorBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Border CornerRadius="4" Padding="6,4" Margin="0,1" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <TextBlock Grid.Column="0" 
                                               Text="{Binding IconSymbol}" 
                                               FontSize="13" 
                                               Margin="0,0,6,0" 
                                               VerticalAlignment="Center"/>

                                    <!-- Name -->
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding Name}" 
                                               FontSize="13" 
                                               FontWeight="Medium" 
                                               Foreground="{DynamicResource TextPrimaryBrush}" 
                                               VerticalAlignment="Center"/>

                                    <!-- Conflict Warning Badge: Icon Only with Tooltip -->
                                    <Border Grid.Column="2" 
                                            Style="{StaticResource ConflictBadgeStyle}" 
                                            Margin="6,0,0,0"
                                            ToolTip="{Binding ConflictTooltip}"
                                            Visibility="{Binding HasConflictVisibility}">
                                        <TextBlock Text="⚠" 
                                                   FontSize="11" 
                                                   FontWeight="Bold" 
                                                   Foreground="{DynamicResource WarningBrush}"/>
                                    </Border>

                                    <!-- Hotkey Badge -->
                                    <Border Grid.Column="3" 
                                            Style="{StaticResource KeyBadgeStyle}" 
                                            Margin="6,0,0,0"
                                            Visibility="{Binding HasHotkey, Converter={x:Null}}">
                                        <TextBlock Text="{Binding HotkeyDisplay}" 
                                                   FontSize="10" 
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>

            <!-- Splitter Divider -->
            <GridSplitter Grid.Column="1" 
                          Width="1" 
                          HorizontalAlignment="Stretch" 
                          Background="{DynamicResource BorderBrush}"/>

            <!-- Right Detail Pane: Action Editor -->
            <ScrollViewer Grid.Column="2" 
                          Background="{DynamicResource BgPrimaryBrush}" 
                          VerticalScrollBarVisibility="Auto" 
                          Padding="24,20">
                <StackPanel x:Name="EditorPanel" Visibility="Visible">
                    <!-- Section Title -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="EditorHeaderTitle" 
                                       Text="Edit Item" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="▶ Test Action" 
                                    Style="{StaticResource SecondaryButtonStyle}" 
                                    Margin="0,0,8,0"
                                    ToolTip="Preview and execute this action immediately to test arguments, prompts, or snippets"
                                    Click="TestActionBtn_Click"/>
                            <Button Content="🗑 Delete" 
                                    Style="{StaticResource SecondaryButtonStyle}" 
                                    Foreground="{DynamicResource ErrorBrush}"
                                    ToolTip="Permanently remove this item or folder from your configuration"
                                    Click="DeleteItemBtn_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Conflict Warning Banner (Visible if conflict exists) -->
                    <Border x:Name="ConflictBanner" 
                            Background="{DynamicResource WarningSubtleBrush}" 
                            BorderBrush="{DynamicResource WarningBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="12,10" 
                            Margin="0,0,0,16" 
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="ConflictBannerTitle" 
                                       Text="⚠ Hotkey Conflict Detected" 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       Foreground="{DynamicResource WarningBrush}"/>
                            <TextBlock x:Name="ConflictBannerMessage" 
                                       Text="" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                       TextWrapping="Wrap" 
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Name and Description -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Item Name" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="ItemNameBox" 
                                     Style="{StaticResource ModernTextBoxStyle}" 
                                     Height="34"
                                     ToolTip="The friendly display title for this action or menu folder"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Description" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="ItemDescBox" 
                                     Style="{StaticResource ModernTextBoxStyle}" 
                                     Height="34"
                                     ToolTip="A short summary displayed in palettes and cursor menus"/>
                        </StackPanel>
                    </Grid>

                    <!-- Type and Presentation Mode -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Action Type" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="ActionTypeCombo" 
                                      Height="34" 
                                      FontSize="13" 
                                      ToolTip="Shell launches applications/scripts, Snippet expands dynamic text, Folder groups items into menus"
                                      SelectionChanged="ActionTypeCombo_SelectionChanged">
                                <ComboBoxItem Content="Shell (Launch App / Script / File)"/>
                                <ComboBoxItem Content="Snippet (Text Expansion)"/>
                                <ComboBoxItem Content="Folder (Menu Container)"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Presentation Mode" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="PresentationModeCombo" 
                                      Height="34" 
                                      FontSize="13"
                                      ToolTip="Direct executes immediately with no UI, Cursor Menu opens a popup at your mouse, Command Palette opens fuzzy search">
                                <ComboBoxItem Content="Direct (Run immediately, no UI)"/>
                                <ComboBoxItem Content="Cursor Context Menu (At mouse pointer)"/>
                                <ComboBoxItem Content="Command Palette (Centered search modal)"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Hotkey and Accelerator -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Global Hotkey Shortcut" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <controls:HotkeyRecorderControl x:Name="HotkeyRecorder" 
                                                            MinHeight="36"
                                                            Height="38"
                                                            ToolTip="Global keyboard shortcut to trigger this item from anywhere in Windows (click and press keys)"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Accelerator Key" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="AcceleratorBox" 
                                     Style="{StaticResource ModernTextBoxStyle}" 
                                     Height="34" 
                                     MaxLength="1"
                                     ToolTip="Single-character key (1-9, A-Z) to execute instantly inside cursor context menus"/>
                        </StackPanel>
                    </Grid>

                    <!-- Shell Settings Box (Visible for Shell type) -->
                    <Border x:Name="ShellSettingsGroup" 
                            Background="{DynamicResource BgSecondaryBrush}" 
                            BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="16" 
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Shell Execution Payload" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

                            <!-- Drag and Drop Target Area & Window Crosshair -->
                            <Border x:Name="DropTargetZone"
                                    Background="{DynamicResource BgInputBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="8"
                                    Padding="14,10"
                                    Margin="0,0,0,12"
                                    AllowDrop="True"
                                    DragOver="DropTargetZone_DragOver"
                                    DragLeave="DropTargetZone_DragLeave"
                                    Drop="DropTargetZone_Drop">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📥" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Drag &amp; drop executable or shortcut (.lnk) here" 
                                                   FontSize="12" 
                                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Crosshair Window Target Tool -->
                                    <Border Grid.Column="1" 
                                            x:Name="ShellCrosshairTarget"
                                            Background="{DynamicResource BgTertiaryBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,5"
                                            Cursor="Cross"
                                            ToolTip="Click &amp; drag onto any open window to capture its application path"
                                            PreviewMouseLeftButtonDown="CrosshairTarget_PreviewMouseLeftButtonDown">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎯" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Target Window" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Command -->
                            <TextBlock Text="Command / Application Path" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" 
                                         x:Name="ShellCommandBox" 
                                         Style="{StaticResource ModernTextBoxStyle}" 
                                         Height="34"
                                         ToolTip="Path to executable, script, document, or URL (environment variables supported)"/>
                                <Button Grid.Column="1" 
                                        Content="Browse..." 
                                        Style="{StaticResource SecondaryButtonStyle}" 
                                        Margin="8,0,0,0" 
                                        ToolTip="Browse local files to select executable or document"
                                        Click="BrowseFileBtn_Click"/>
                                <Border Grid.Column="2" 
                                        Background="{DynamicResource BgTertiaryBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,0"
                                        Margin="8,0,0,0"
                                        Cursor="Cross"
                                        VerticalAlignment="Stretch"
                                        ToolTip="Click &amp; drag onto any open window to capture application path"
                                        PreviewMouseLeftButtonDown="CrosshairTarget_PreviewMouseLeftButtonDown">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🎯" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Target" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Arguments -->
                            <TextBlock Text="Command-Line Arguments" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="ShellArgsBox" 
                                     Style="{StaticResource ModernTextBoxStyle}" 
                                     Height="34" 
                                     Margin="0,0,0,10"
                                     ToolTip="Command-line flags and parameters passed to the executable"/>

                            <!-- Working Directory -->
                            <TextBlock Text="Working Directory (Optional)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" 
                                         x:Name="ShellWorkDirBox" 
                                         Style="{StaticResource ModernTextBoxStyle}" 
                                         Height="34"
                                         ToolTip="Execution folder for the process (defaults to the target file's parent folder)"/>
                                <Button Grid.Column="1" 
                                        Content="Browse..." 
                                        Style="{StaticResource SecondaryButtonStyle}" 
                                        Margin="8,0,0,0" 
                                        ToolTip="Browse folders to select working directory"
                                        Click="BrowseDirBtn_Click"/>
                            </Grid>

                            <!-- Admin Checkbox -->
                            <CheckBox x:Name="ShellRunAsAdminCheck" 
                                      Content="Run elevated as Administrator (runas)" 
                                      FontSize="13" 
                                      Margin="0,4,0,0"
                                      ToolTip="Runs process with elevated Windows Administrator privileges (triggers UAC prompt)"/>
                        </StackPanel>
                    </Border>

                    <!-- Snippet Settings Box (Visible for Snippet type) -->
                    <Border x:Name="SnippetSettingsGroup" 
                            Background="{DynamicResource BgSecondaryBrush}" 
                            BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="16" 
                            Margin="0,0,0,16" 
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Snippet Template" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                            <TextBlock Text="Supports dynamic tokens and interactive prompts." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                            <!-- Quick Insert Token Chips -->
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="+ {date}" Style="{StaticResource SecondaryButtonStyle}" Padding="6,3" Margin="0,0,5,5" ToolTip="Inserts current date (yyyy-MM-dd)" Click="InsertTokenChip_Click" Tag="{}{date}"/>
                                <Button Content="+ {time}" Style="{StaticResource SecondaryButtonStyle}" Padding="6,3" Margin="0,0,5,5" ToolTip="Inserts current time (HH:mm:ss)" Click="InsertTokenChip_Click" Tag="{}{time}"/>
                                <Button Content="+ {datetime}" Style="{StaticResource SecondaryButtonStyle}" Padding="6,3" Margin="0,0,5,5" ToolTip="Inserts current date and time (yyyy-MM-dd HH:mm:ss)" Click="InsertTokenChip_Click" Tag="{}{datetime}"/>
                                <Button Content="+ {clipboard}" Style="{StaticResource SecondaryButtonStyle}" Padding="6,3" Margin="0,0,5,5" ToolTip="Inserts current clipboard text" Click="InsertTokenChip_Click" Tag="{}{clipboard}"/>
                                <Button Content="+ {cursor}" Style="{StaticResource SecondaryButtonStyle}" Padding="6,3" Margin="0,0,5,5" ToolTip="Positions the cursor caret here post-paste" Click="InsertTokenChip_Click" Tag="{}{cursor}"/>
                                <Button Content="+ {text:Label}" Style="{StaticResource SecondaryButtonStyle}" Padding="6,3" Margin="0,0,5,5" ToolTip="Prompts for a single-line text input" Click="InsertTokenChip_Click" Tag="{}{text:Label}"/>
                                <Button Content="+ {choice:Label|Opt1=Val1,Opt2}" Style="{StaticResource SecondaryButtonStyle}" Padding="6,3" Margin="0,0,5,5" ToolTip="Prompts for a single selection from friendly options mapped to values" Click="InsertTokenChip_Click" Tag="{}{choice:Label|Opt1=Val1,Opt2}"/>
                                <Button Content="+ {number:Label|1,10}" Style="{StaticResource SecondaryButtonStyle}" Padding="6,3" Margin="0,0,5,5" ToolTip="Prompts for a numeric value with range limits" Click="InsertTokenChip_Click" Tag="{}{number:Label|1,10}"/>
                                <Button Content="+ {multiline:Label}" Style="{StaticResource SecondaryButtonStyle}" Padding="6,3" Margin="0,0,5,5" ToolTip="Prompts for multi-line text input" Click="InsertTokenChip_Click" Tag="{}{multiline:Label}"/>
                                <Button Content="+ {date_picker:Label}" Style="{StaticResource SecondaryButtonStyle}" Padding="6,3" Margin="0,0,5,5" ToolTip="Prompts with an interactive date picker" Click="InsertTokenChip_Click" Tag="{}{date_picker:Label}"/>
                            </WrapPanel>

                            <!-- Snippet Editor -->
                            <TextBox x:Name="SnippetTemplateBox" 
                                     Style="{StaticResource ModernTextBoxStyle}" 
                                     FontFamily="{StaticResource CodeFont}" 
                                     FontSize="13" 
                                     Height="120" 
                                     AcceptsReturn="True" 
                                     TextWrapping="Wrap" 
                                     VerticalScrollBarVisibility="Auto" 
                                     ToolTip="Enter the text template to expand. Click token chips above to insert dynamic tokens"/>
                        </StackPanel>
                    </Border>

                    <!-- Context Process Filter Settings -->
                    <Border Background="{DynamicResource BgSecondaryBrush}" 
                            BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="16"
                            AllowDrop="True"
                            DragOver="ProcessFilterGroup_DragOver"
                            Drop="ProcessFilterGroup_Drop">
                        <StackPanel>
                            <TextBlock Text="Process Context Rules (Optional)" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                            <TextBlock Text="Scope this action to specific applications or browser URLs. Drag executables or use target tools." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                            <!-- Allowed Processes -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" 
                                           Text="Allowed Processes (Leave empty to allow all applications)" 
                                           FontWeight="SemiBold" 
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="📋 Browse Running..." 
                                            Style="{StaticResource SecondaryButtonStyle}" 
                                            Padding="7,2" 
                                            FontSize="11"
                                            Margin="0,0,6,0"
                                            ToolTip="Pick from currently running desktop applications"
                                            Tag="Allowed"
                                            Click="BrowseRunningProcess_Click"/>
                                    <Button Content="📁 Browse File..." 
                                            Style="{StaticResource SecondaryButtonStyle}" 
                                            Padding="7,2" 
                                            FontSize="11"
                                            Margin="0,0,6,0"
                                            ToolTip="Select an executable file from disk"
                                            Tag="Allowed"
                                            Click="BrowseFileProcess_Click"/>
                                    <Border Background="{DynamicResource BgTertiaryBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="7,2"
                                            Cursor="Cross"
                                            ToolTip="Click &amp; drag crosshair onto any open window to add to Allowed list"
                                            Tag="Allowed"
                                            PreviewMouseLeftButtonDown="ProcessCrosshair_PreviewMouseLeftButtonDown">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎯" FontSize="11" Margin="0,0,4,0"/>
                                            <TextBlock Text="Target" FontSize="11" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <controls:TagInputControl x:Name="AllowedProcessesTagInput" 
                                                      Placeholder="Type process (e.g. code.exe) and press Enter..." 
                                                      Margin="0,0,0,14"/>

                            <!-- Excluded Processes -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" 
                                           Text="Excluded Processes (Action will not trigger if any match)" 
                                           FontWeight="SemiBold" 
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="📋 Browse Running..." 
                                            Style="{StaticResource SecondaryButtonStyle}" 
                                            Padding="7,2" 
                                            FontSize="11"
                                            Margin="0,0,6,0"
                                            ToolTip="Pick from currently running desktop applications"
                                            Tag="Excluded"
                                            Click="BrowseRunningProcess_Click"/>
                                    <Button Content="📁 Browse File..." 
                                            Style="{StaticResource SecondaryButtonStyle}" 
                                            Padding="7,2" 
                                            FontSize="11"
                                            Margin="0,0,6,0"
                                            ToolTip="Select an executable file from disk"
                                            Tag="Excluded"
                                            Click="BrowseFileProcess_Click"/>
                                    <Border Background="{DynamicResource BgTertiaryBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="7,2"
                                            Cursor="Cross"
                                            ToolTip="Click &amp; drag crosshair onto any open window to add to Excluded list"
                                            Tag="Excluded"
                                            PreviewMouseLeftButtonDown="ProcessCrosshair_PreviewMouseLeftButtonDown">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎯" FontSize="11" Margin="0,0,4,0"/>
                                            <TextBlock Text="Target" FontSize="11" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <controls:TagInputControl x:Name="ExcludedProcessesTagInput" 
                                                      Placeholder="Type process (e.g. chrome.exe) and press Enter..." 
                                                      Margin="0,0,0,16"/>

                            <!-- Browser URL Filtering Section -->
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Browser Tab &amp; URL Rules (Optional)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Filters active browser tabs (Chrome, Edge, Firefox, Brave). Supports wildcards: *github.com*, localhost:*" 
                                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" 
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource BgTertiaryBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="7,2"
                                                Cursor="Cross"
                                                ToolTip="Click &amp; drag crosshair onto an open browser tab to capture its active URL"
                                                Tag="AllowedUrl"
                                                PreviewMouseLeftButtonDown="ProcessCrosshair_PreviewMouseLeftButtonDown">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🎯" FontSize="11" Margin="0,0,4,0"/>
                                                <TextBlock Text="Target Tab URL" FontSize="11" FontWeight="Medium"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="Allowed URLs (Comma-separated or pill tags, leave blank for all)" FontWeight="Medium" FontSize="12" Margin="0,8,0,5"/>
                                    <controls:TagInputControl x:Name="AllowedUrlsTagInput" 
                                                              Placeholder="e.g. *github.com*, localhost:* (press Enter)..." 
                                                              Margin="0,0,0,10"/>

                                    <TextBlock Text="Excluded URLs (Action suppressed on these pages)" FontWeight="Medium" FontSize="12" Margin="0,0,0,5"/>
                                    <controls:TagInputControl x:Name="ExcludedUrlsTagInput" 
                                                              Placeholder="e.g. *youtube.com*, *netflix.com* (press Enter)..."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" 
                Background="{DynamicResource BgSecondaryBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Text="Single-Instance Mutex &amp; NamedPipe Active" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
