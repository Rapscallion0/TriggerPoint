<Window x:Class="TriggerPoint.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TriggerPoint.UI.Controls"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="TriggerPoint — Precision Shortcuts &amp; Launcher Settings"
        Icon="{DynamicResource AppIconSource}"
        Width="960" Height="650"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        Background="{DynamicResource BgPrimaryBrush}"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Custom Title Bar Toolbar -->
        <Border Grid.Row="0" 
                Background="{DynamicResource BgSecondaryBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="16,8,8,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{DynamicResource AppIconSource}" 
                           Width="24" Height="24" 
                           Margin="0,0,10,0" 
                           VerticalAlignment="Center" 
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel>
                        <TextBlock Text="TriggerPoint" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Precision shortcuts. Instant menus. Zero bloat." FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Actions Toolbar -->
                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="SnoozeToggleBtn"
                            Content="🔔 Active" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Margin="0,0,8,0"
                            ToolTip="Toggle global hotkeys snooze mode"
                            Click="SnoozeToggleBtn_Click"/>

                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                            Width="32" Height="32"
                            Padding="0"
                            Margin="0,0,16,0"
                            ToolTip="Application Settings (Log Level, Log Retention, Theme, Startup)"
                            Click="AppSettingsBtn_Click">
                        <Path Width="14" Height="14" 
                              Stretch="Uniform" 
                              Fill="{DynamicResource TextPrimaryBrush}"
                              Data="{DynamicResource SettingsGearGeometry}"/>
                    </Button>
                </StackPanel>

                <!-- Custom Window System Buttons -->
                <StackPanel Grid.Column="3" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" 
                            Style="{StaticResource WindowControlButtonStyle}" 
                            ToolTip="Minimize"
                            Click="WindowMinimize_Click"/>
                    <Button x:Name="MaximizeBtn" 
                            Content="▢" 
                            Style="{StaticResource WindowControlButtonStyle}" 
                            ToolTip="Maximize or Restore"
                            Click="WindowMaximize_Click"/>
                    <Button Content="✕" 
                            Style="{StaticResource WindowCloseButtonStyle}" 
                            ToolTip="Close (Minimizes to Tray)"
                            Click="WindowClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Master-Detail Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260" MaxWidth="450"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Master Pane: TreeView of Items -->
            <Grid Grid.Column="0" Background="{DynamicResource BgSecondaryBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tree Header: Search & Add Dropdown + Filters -->
                <StackPanel Grid.Row="0" Margin="12,10,12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 x:Name="TreeSearchBox"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Height="32"
                                 Tag="Search actions..."
                                 ToolTip="Filter shortcuts and folders by name or description"
                                 TextChanged="TreeSearchBox_TextChanged"/>

                        <Button Grid.Column="1"
                                x:Name="ToggleShortcutsBadgeBtn"
                                Content="⌨"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="32" Height="32"
                                FontSize="13"
                                Padding="0"
                                Margin="6,0,0,0"
                                ToolTip="Toggle hotkey badges in tree"
                                Click="ToggleShortcutsBadgeBtn_Click"/>

                        <Button Grid.Column="2"
                                x:Name="ToggleExpandAllBtn"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="32" Height="32"
                                Padding="0"
                                Margin="4,0,0,0"
                                ToolTip="Collapse All Folders"
                                Click="ToggleExpandAllBtn_Click">
                            <Path x:Name="TreeExpandAllIcon" 
                                  Width="14" Height="14" 
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource TextPrimaryBrush}" 
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" 
                                  StrokeEndLineCap="Round" 
                                  StrokeLineJoin="Round"
                                  Data="M 2,3.5 L 8.5,3.5 M 4,8 L 8.5,8 M 6,12.5 L 8.5,12.5 M 13,12.5 L 13,4 M 10.5,6.5 L 13,4 L 15.5,6.5"
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                        </Button>

                        <Button Grid.Column="3"
                                x:Name="AddMenuBtn"
                                Content="+"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="32" Height="32"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Padding="0"
                                Margin="4,0,0,0"
                                ToolTip="Add item or folder"
                                Click="AddMenuBtn_Click">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="AddButtonContextMenu">
                                    <MenuItem Header="New App &amp; Command" Click="AddShellActionBtn_Click">
                                        <MenuItem.Icon>
                                            <TextBlock Text="⚡" FontSize="13" Foreground="{DynamicResource ShellBrush}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="New Snippet" Click="AddSnippetActionBtn_Click">
                                        <MenuItem.Icon>
                                            <TextBlock Text="📝" FontSize="13" Foreground="{DynamicResource SnippetBrush}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="New Workflow" Click="AddWorkflowActionBtn_Click">
                                        <MenuItem.Icon>
                                            <TextBlock Text="🔀" FontSize="13" Foreground="{DynamicResource WorkflowBrush}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="New Folder" Click="AddFolderBtn_Click">
                                        <MenuItem.Icon>
                                            <TextBlock Text="📁" FontSize="13" Foreground="{DynamicResource FolderBrush}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>

                    <!-- Filter Chips -->
                    <WrapPanel Margin="0,6,0,0" x:Name="TreeFilterChipsPanel">
                        <Button x:Name="BrokenFilterChip"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="8,3"
                                Height="24"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource ErrorBrush}"
                                BorderBrush="{DynamicResource ErrorBrush}"
                                Background="#1AEF4444"
                                Visibility="Collapsed"
                                ToolTip="Click to toggle filtering for only items with invalid target paths"
                                Click="BrokenFilterChip_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✕ " FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock x:Name="BrokenFilterChipText" Text="0 Broken" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>

                <!-- TreeView -->
                <TreeView Grid.Row="1"
                          x:Name="ItemsTreeView"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="8,4"
                          AllowDrop="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="ItemsTreeView_PreviewMouseWheel"
                          PreviewMouseLeftButtonDown="ItemsTreeView_PreviewMouseLeftButtonDown"
                          PreviewMouseLeftButtonUp="ItemsTreeView_PreviewMouseLeftButtonUp"
                          PreviewMouseRightButtonDown="ItemsTreeView_PreviewMouseRightButtonDown"
                          MouseMove="ItemsTreeView_MouseMove"
                          MouseLeave="ItemsTreeView_MouseLeave"
                          DragOver="ItemsTreeView_DragOver"
                          DragLeave="ItemsTreeView_DragLeave"
                          Drop="ItemsTreeView_Drop"
                          PreviewKeyDown="ItemsTreeView_PreviewKeyDown"
                          SelectedItemChanged="ItemsTreeView_SelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <EventSetter Event="RequestBringIntoView" Handler="TreeViewItem_RequestBringIntoView"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ContextMenu>
                        <ContextMenu x:Name="TreeContextMenu" Opened="TreeContextMenu_Opened" Closed="TreeContextMenu_Closed">
                            <MenuItem x:Name="ContextAddMenu" Header="New" PreviewMouseLeftButtonDown="ContextAddMenu_PreviewMouseLeftButtonDown">
                                <MenuItem.Icon>
                                    <TextBlock Text="➕" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                                </MenuItem.Icon>
                                <MenuItem x:Name="ContextAddShellItem" Header="New App &amp; Command" Click="AddShellActionBtn_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="⚡" FontSize="13" Foreground="{DynamicResource ShellBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="ContextAddSnippetItem" Header="New Snippet" Click="AddSnippetActionBtn_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="📝" FontSize="13" Foreground="{DynamicResource SnippetBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="ContextAddWorkflowItem" Header="New Workflow" Click="AddWorkflowActionBtn_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="🔀" FontSize="13" Foreground="{DynamicResource WorkflowBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem x:Name="ContextAddFolderItem" Header="New Folder" Click="AddFolderBtn_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="📁" FontSize="13" Foreground="{DynamicResource FolderBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <MenuItem x:Name="ContextDuplicateItem" Header="Duplicate" InputGestureText="Ctrl+D" Click="DuplicateItemBtn_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="⧉" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ContextRenameItem" Header="Rename" InputGestureText="F2" Click="ContextRenameItem_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="✏" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator x:Name="ContextDeleteSeparator"/>
                            <MenuItem x:Name="ContextDeleteItem" Header="Delete" InputGestureText="Del" Click="DeleteItemBtn_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="🗑" FontSize="13" Foreground="{DynamicResource ErrorBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem x:Name="ContextToggleCompactDensity" Header="Compact View" IsCheckable="True" Click="ContextToggleCompactDensity_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="≡" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator x:Name="ContextExportSeparator"/>
                            <MenuItem x:Name="ContextExportItem" Header="Export..." Click="ContextExportItem_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="📤" FontSize="13"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ContextImportItem" Header="Import..." Click="ContextImportItem_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="📥" FontSize="13"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ContextRestoreItem" Header="Restore" Click="RestoreRecycledItemBtn_Click" Visibility="Collapsed">
                                <MenuItem.Icon>
                                    <TextBlock Text="↺" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ContextPermanentDeleteItem" Header="Delete Permanently" Click="PermanentlyDeleteRecycledItemBtn_Click" Visibility="Collapsed">
                                <MenuItem.Icon>
                                    <TextBlock Text="✕" FontSize="13" Foreground="{DynamicResource ErrorBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ContextEmptyRecycleBinItem" Header="Empty Recycle Bin" Click="EmptyRecycleBinFromSettingsBtn_Click" Visibility="Collapsed">
                                <MenuItem.Icon>
                                    <TextBlock Text="🗑" FontSize="13" Foreground="{DynamicResource ErrorBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}" ItemContainerStyle="{StaticResource {x:Type TreeViewItem}}">
                            <Grid Margin="{DynamicResource TreeItemRowMargin}">
                                <!-- Drop Above Indicator Line with Bead -->
                                <Grid VerticalAlignment="Top" Height="4" Margin="0,-2,0,0" Panel.ZIndex="10" Visibility="{Binding DropAboveVisibility}">
                                    <Border Height="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Main Item Row Container -->
                                <Border CornerRadius="4" 
                                        Padding="{DynamicResource TreeItemPadding}" 
                                        Background="{Binding DropInsideBackgroundBrush}" 
                                        BorderBrush="{Binding DropInsideBorderBrush}" 
                                        BorderThickness="1.5">
                                    <Grid MinHeight="{DynamicResource TreeItemMinHeight}" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon -->
                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding IconSymbol}" 
                                                   Foreground="{Binding IconBrush}"
                                                   FontSize="13" 
                                                   Margin="0,0,6,0" 
                                                   VerticalAlignment="Center"/>

                                        <!-- Name Display -->
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding Name}" 
                                                   FontSize="13" 
                                                   FontWeight="Medium" 
                                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}"
                                                   Visibility="{Binding NameDisplayVisibility}"/>

                                        <!-- Inline Rename Input Box -->
                                        <TextBox Grid.Column="1"
                                                 x:Name="InlineRenameBox"
                                                 Text="{Binding EditingNameText, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12.5"
                                                 FontWeight="Medium"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 Background="{DynamicResource BgInputBrush}"
                                                 BorderBrush="{DynamicResource AccentBrush}"
                                                 BorderThickness="1"
                                                 Padding="4,1"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding NameEditVisibility}"
                                                 PreviewKeyDown="InlineRenameBox_PreviewKeyDown"
                                                 KeyDown="InlineRenameBox_KeyDown"
                                                 LostFocus="InlineRenameBox_LostFocus"
                                                 IsVisibleChanged="InlineRenameBox_IsVisibleChanged"/>

                                        <!-- Broken Shortcut Badge: Icon Only with Tooltip -->
                                        <Border Grid.Column="2" 
                                                Style="{StaticResource ConflictBadgeStyle}" 
                                                Background="#25EF4444"
                                                BorderBrush="{DynamicResource ErrorBrush}"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding BrokenTargetTooltip}"
                                                Visibility="{Binding BrokenTargetVisibility}">
                                            <TextBlock Text="✕" 
                                                       FontSize="10" 
                                                       FontWeight="Bold" 
                                                       Foreground="{DynamicResource ErrorBrush}"/>
                                        </Border>

                                        <!-- Conflict Warning Badge: Icon Only with Tooltip -->
                                        <Border Grid.Column="3" 
                                                Style="{StaticResource ConflictBadgeStyle}" 
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding ConflictTooltip}"
                                                Visibility="{Binding HasConflictVisibility}">
                                            <TextBlock Text="⚠" 
                                                       FontSize="11" 
                                                       FontWeight="Bold" 
                                                       Foreground="{DynamicResource WarningBrush}"/>
                                        </Border>

                                        <!-- Hotkey Badge -->
                                        <Border Grid.Column="4" 
                                                Style="{StaticResource AccentKeyBadgeStyle}" 
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasHotkey}">
                                            <TextBlock Text="{Binding HotkeyDisplay}" 
                                                       FontSize="10" 
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Drop Below Indicator Line with Bead -->
                                <Grid VerticalAlignment="Bottom" Height="4" Margin="0,0,0,-2" Panel.ZIndex="10" Visibility="{Binding DropBelowVisibility}">
                                    <Border Height="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <!-- Floating Drag Preview Ghost -->
                <Popup x:Name="TreeDragGhostPopup"
                       AllowsTransparency="True"
                       Placement="AbsolutePoint"
                       IsOpen="False"
                       IsHitTestVisible="False"
                       Focusable="False">
                    <Border Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4"
                            Opacity="0.92">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TreeDragGhostIcon" Text="⚡" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TreeDragGhostText" Text="Item" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- Splitter Divider (Wider grab target with responsive hover indicator) -->
            <GridSplitter Grid.Column="1" 
                          Width="6" 
                          HorizontalAlignment="Stretch" 
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Cursor="SizeWE"
                          Background="Transparent"
                          ShowsPreview="False">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="{x:Type GridSplitter}">
                        <Border Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Border Width="1" 
                                    HorizontalAlignment="Center" 
                                    VerticalAlignment="Stretch" 
                                    Background="{DynamicResource BorderBrush}"
                                    x:Name="SplitterLine"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SplitterLine" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="SplitterLine" Property="Width" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- Right Detail Pane: Action Editor -->
            <Grid Grid.Column="2" Background="{DynamicResource BgPrimaryBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Sticky Action Header -->
                    <RowDefinition Height="Auto"/> <!-- Sticky Recycled Item Banner -->
                    <RowDefinition Height="*"/>    <!-- Scrollable Form Body -->
                </Grid.RowDefinitions>

                <!-- Sticky Header Bar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource BgPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="24,10,24,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Title and Badge with Ellipsis Truncation -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="EditorHeaderTitle" 
                                       Text="Item Name" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                       Margin="0,0,0,4"/>

                            <Border x:Name="EditorTypeBadge"
                                    HorizontalAlignment="Left"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="EditorTypeBadgeText"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <!-- Toolbar: Save, Test, Delete -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SaveBtn"
                                    Content="💾 Save" 
                                    Style="{StaticResource AccentButtonStyle}" 
                                    Margin="0,0,6,0"
                                    IsEnabled="False"
                                    ToolTip="Save all changes to disk and register hotkeys (Ctrl+S)"
                                    Click="SaveBtn_Click"/>

                            <Button x:Name="RevertItemBtn"
                                    Content="↺" 
                                    Style="{StaticResource SecondaryButtonStyle}" 
                                    Margin="0,0,8,0"
                                    Width="34" Height="34"
                                    Padding="0"
                                    FontSize="20"
                                    IsEnabled="False"
                                    ToolTip="Revert unsaved changes to this item"
                                    Click="RevertItemBtn_Click"/>

                            <Button x:Name="TestActionBtn"
                                    Content="▶ Test" 
                                    Style="{StaticResource TestActionButtonStyle}" 
                                    Margin="0,0,8,0"
                                    ToolTip="Preview and execute this action immediately to test arguments, prompts, or snippets"
                                    Click="TestActionBtn_Click"/>

                            <Button x:Name="DeleteItemBtn"
                                    Content="🗑" 
                                    Style="{StaticResource SecondaryButtonStyle}" 
                                    Foreground="{DynamicResource ErrorBrush}"
                                    BorderBrush="{DynamicResource ErrorBrush}"
                                    Width="34" Height="34"
                                    Padding="0"
                                    FontSize="14"
                                    ToolTip="Move this item or folder to the Recycle Bin"
                                    Click="DeleteItemBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Sticky Recycled Item Action Banner (Visible when viewing deleted item) -->
                <Border x:Name="RecycledItemBanner"
                        Grid.Row="1"
                        Background="{DynamicResource WarningSubtleBrush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="24,12"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🗑" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Deleted Item (Read-Only Preview)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="RestoreRecycledItemBtn"
                                    Content="↺ Restore"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="14,6"
                                    Margin="0,0,8,0"
                                    Click="RestoreRecycledItemBtn_Click"/>
                            <Button x:Name="PermanentlyDeleteRecycledItemBtn"
                                    Content="✕ Delete Permanently"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Foreground="{DynamicResource ErrorBrush}"
                                    BorderBrush="{DynamicResource ErrorBrush}"
                                    Padding="12,6"
                                    Click="PermanentlyDeleteRecycledItemBtn_Click"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   x:Name="RecycledItemInfoText"
                                   Text="Deleted on --/--/----"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="23,6,0,0"/>
                    </Grid>
                </Border>

                <!-- Scrollable Form Body -->
                <ScrollViewer x:Name="EditorScrollViewer"
                              Grid.Row="2" 
                              Background="Transparent" 
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="24,16">
                    <StackPanel x:Name="EditorPanel" Visibility="Visible">

                    <!-- Conflict Warning Banner (Visible if conflict exists) -->
                    <Border x:Name="ConflictBanner" 
                            Background="{DynamicResource WarningSubtleBrush}" 
                            BorderBrush="{DynamicResource WarningBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="12,10" 
                            Margin="0,0,0,16" 
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="ConflictBannerTitle" 
                                       Text="⚠ Hotkey Conflict Detected" 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       Foreground="{DynamicResource WarningBrush}"/>
                            <TextBlock x:Name="ConflictBannerMessage" 
                                       Text="" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                       TextWrapping="Wrap" 
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Name and Description -->
                    <Grid x:Name="ItemNameDescRow" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Item Name" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="ItemNameBox" 
                                     Style="{StaticResource ModernTextBoxStyle}" 
                                     Height="34"
                                     ToolTip="The friendly display title for this action or menu folder"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Description" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="ItemDescBox" 
                                     Style="{StaticResource ModernTextBoxStyle}" 
                                     Height="34"
                                     ToolTip="A short summary displayed in palettes and cursor menus"/>
                        </StackPanel>
                    </Grid>

                    <!-- Presentation Mode (Visible for Folders) -->
                    <Grid x:Name="ItemTypePresentationRow" Margin="0,0,0,14">
                        <StackPanel x:Name="PresentationModeGroup" Visibility="Collapsed">
                            <TextBlock Text="Presentation Mode" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="PresentationModeCombo" 
                                      Height="34" 
                                      FontSize="13" 
                                      ToolTip="Direct executes immediately with no UI, Cursor Menu opens a popup at your mouse, Command Palette opens fuzzy search">
                                <ComboBoxItem x:Name="PresentationDirectItem" Content="Direct (Run immediately, no UI)"/>
                                <ComboBoxItem x:Name="PresentationCursorMenuItem" Content="Cursor Context Menu (At mouse pointer)"/>
                                <ComboBoxItem x:Name="PresentationCommandPaletteItem" Content="Command Palette (Centered search modal)"/>
                            </ComboBox>

                            <!-- Menu Quick-Access Auto-Numbering Options (Visible when CursorMenu or CommandPalette) -->
                            <StackPanel x:Name="AutoNumberGroup" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Menu Item Quick-Access Keys" FontWeight="SemiBold"/>
                                    <Button x:Name="AutoNumberInfoBtn" 
                                            Content="ⓘ" 
                                            FontSize="12" 
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource AccentBrush}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="4,0"
                                            Margin="4,0,0,0"
                                            Cursor="Hand"
                                            ToolTip="Click for details on auto-numbering modes and conflict resolution"
                                            Click="AutoNumberInfoBtn_Click"/>
                                </StackPanel>
                                <ComboBox x:Name="AutoNumberModeCombo" Height="34" FontSize="13" SelectionChanged="AutoNumberModeCombo_SelectionChanged">
                                    <ComboBoxItem Content="Off — Manual Quick-Keys Only"/>
                                    <ComboBoxItem Content="Smart Fill — Auto-assign remaining (1-9, A-Z)"/>
                                    <ComboBoxItem Content="Strict Positional — Sequential (1-9, A-Z) by row order"/>
                                </ComboBox>

                                <!-- Informative Helper Card -->
                                <Border x:Name="AutoNumberInfoCard" 
                                        Background="{DynamicResource CardBgBrush}" 
                                        BorderBrush="{DynamicResource CardBorderBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="12,10" 
                                        Margin="0,8,0,0" 
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Quick-Access Keys &amp; Modes" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                                            <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMutedBrush}" Cursor="Hand" Click="CloseAutoNumberInfoCard_Click"/>
                                        </Grid>
                                        <TextBlock Text="• Off: Only child items with an explicit Menu Quick-Key can be triggered by key." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                        <TextBlock Text="• Smart Fill: User-defined quick-keys take priority. All unassigned child items are automatically assigned the next available key in sequence (1-9, A-Z) with no collisions." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                        <TextBlock Text="• Strict Positional: Child items are automatically assigned 1-9, then A-Z in row order (up to 35 direct keys). Child items do not need manual quick-keys." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                        <TextBlock Text="• Sequence: 1 to 9, followed by A to Z (excludes 0)." FontSize="11" FontStyle="Italic" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Hotkey and Accelerator -->
                    <Grid x:Name="ItemHotkeyRow" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Global Hotkey Shortcut" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <controls:HotkeyRecorderControl x:Name="HotkeyRecorder" 
                                                            MinHeight="36"
                                                            Height="38"
                                                            ToolTip="Global keyboard shortcut to trigger this item from anywhere in Windows (click and press keys)"/>
                            <TextBlock x:Name="HotkeyInlineConflictText"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource WarningBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" x:Name="AcceleratorGroup">
                            <TextBlock x:Name="AcceleratorLabel" Text="Menu Quick-Key" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="AcceleratorBox" 
                                     Style="{StaticResource ModernTextBoxStyle}" 
                                     Height="34" 
                                     MaxLength="1"
                                     HorizontalContentAlignment="Center"
                                     FontWeight="Bold"
                                     ToolTip="Single key (1-9, A-Z) to jump &amp; execute instantly inside popup cursor menus"/>
                            <TextBlock x:Name="AcceleratorHintText"
                                       Text="Popup menus only" 
                                       FontSize="10.5" 
                                       Foreground="{DynamicResource TextMutedBrush}" 
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Shell Settings Box (Visible for Shell type) -->
                    <Border x:Name="ShellSettingsGroup" 
                            Background="{DynamicResource CardBgBrush}" 
                            BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="16" 
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Shell Execution Payload" FontWeight="Bold" FontSize="14" Margin="0,0,0,0"/>

                            <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,8,0,12" SnapsToDevicePixels="True"/>

                            <!-- Drag and Drop Target Area & Window Crosshair -->
                            <Border x:Name="DropTargetZone"
                                    Background="{DynamicResource BgInputBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="8"
                                    Padding="14,10"
                                    Margin="0,0,0,12"
                                    AllowDrop="True"
                                    DragOver="DropTargetZone_DragOver"
                                    DragLeave="DropTargetZone_DragLeave"
                                    Drop="DropTargetZone_Drop">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📥" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Drag &amp; drop executable or shortcut (.lnk) here" 
                                                   FontSize="12" 
                                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Crosshair Window Target Tool -->
                                    <Border Grid.Column="1" 
                                            x:Name="ShellCrosshairTarget"
                                            Background="{DynamicResource BgTertiaryBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,5"
                                            Cursor="Cross"
                                            ToolTip="Click &amp; drag onto any open window to capture its application path"
                                            PreviewMouseLeftButtonDown="CrosshairTarget_PreviewMouseLeftButtonDown">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎯" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Target Window" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Command -->
                            <TextBlock Text="Command / Application Path" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" 
                                         x:Name="ShellCommandBox" 
                                         Style="{StaticResource ModernTextBoxStyle}" 
                                         Height="34"
                                         ToolTip="Path to executable, script, document, or URL (environment variables supported)"/>
                                <Button Grid.Column="1" 
                                        Content="Browse..." 
                                        Style="{StaticResource SecondaryButtonStyle}" 
                                        Margin="8,0,0,0" 
                                        ToolTip="Browse local files to select executable or document"
                                        Click="BrowseFileBtn_Click"/>
                                <Border Grid.Column="2" 
                                        Background="{DynamicResource BgTertiaryBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,0"
                                        Margin="8,0,0,0"
                                        Cursor="Cross"
                                        VerticalAlignment="Stretch"
                                        ToolTip="Click &amp; drag onto any open window to capture application path"
                                        PreviewMouseLeftButtonDown="CrosshairTarget_PreviewMouseLeftButtonDown">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🎯" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Target" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="CommandValidationStatusText"
                                       FontSize="11.5"
                                       Margin="2,0,0,10"
                                       Visibility="Collapsed"/>

                            <!-- Arguments -->
                            <TextBlock Text="Command-Line Arguments" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="ShellArgsBox" 
                                     Style="{StaticResource ModernTextBoxStyle}" 
                                     Height="34" 
                                     Margin="0,0,0,10"
                                     ToolTip="Command-line flags and parameters passed to the executable"/>

                            <!-- Working Directory -->
                            <TextBlock Text="Working Directory (Optional)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" 
                                         x:Name="ShellWorkDirBox" 
                                         Style="{StaticResource ModernTextBoxStyle}" 
                                         Height="34"
                                         ToolTip="Execution folder for the process (defaults to the target file's parent folder)"/>
                                <Button Grid.Column="1" 
                                        Content="Browse..." 
                                        Style="{StaticResource SecondaryButtonStyle}" 
                                        Margin="8,0,0,0" 
                                        ToolTip="Browse folders to select working directory"
                                        Click="BrowseDirBtn_Click"/>
                            </Grid>

                            <!-- Admin Checkbox -->
                            <CheckBox x:Name="ShellRunAsAdminCheck" 
                                      Content="Run elevated as Administrator (runas)" 
                                      FontSize="13" 
                                      Margin="0,4,0,0"
                                      ToolTip="Runs process with elevated Windows Administrator privileges (triggers UAC prompt)"/>

                            <!-- Display Target -->
                            <TextBlock Text="Display Target" FontWeight="SemiBold" Margin="0,10,0,6"/>
                            <ComboBox x:Name="ShellDisplayTargetCombo"
                                      Height="34"
                                      FontSize="13"
                                      ToolTip="Target monitor to launch this application or document on"
                                      SelectionChanged="ShellDisplayTargetCombo_SelectionChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Snippet Settings Box (Visible for Snippet type) -->
                    <Border x:Name="SnippetSettingsGroup" 
                            Background="{DynamicResource CardBgBrush}" 
                            BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="16" 
                            Margin="0,0,0,16" 
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Snippet Template" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                            <TextBlock Text="Supports dynamic tokens and interactive prompts." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,0"/>

                            <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,8,0,12" SnapsToDevicePixels="True"/>

                            <!-- Quick Insert Token Chips -->
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="+ {date} ▾" Style="{StaticResource TokenChipDateStyle}" Margin="0,0,5,5" ToolTip="Left-click to insert {date}. Right-click for presets." Click="InsertTokenChip_Click" Tag="{}{date}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Standard: {date} (2026-09-09)" Click="InsertTokenPreset_Click" Tag="{}{date}"/>
                                            <MenuItem Header="US Format: {date:MM/dd/yyyy}" Click="InsertTokenPreset_Click" Tag="{}{date:MM/dd/yyyy}"/>
                                            <MenuItem Header="European: {date:dd/MM/yyyy}" Click="InsertTokenPreset_Click" Tag="{}{date:dd/MM/yyyy}"/>
                                            <MenuItem Header="Full Day &amp; Date: {date:dddd, MMMM d, yyyy}" Click="InsertTokenPreset_Click" Tag="{}{date:dddd, MMMM d, yyyy}"/>
                                            <Separator/>
                                            <MenuItem Header="Tomorrow: {date:+1d}" Click="InsertTokenPreset_Click" Tag="{}{date:+1d}"/>
                                            <MenuItem Header="Yesterday: {date:-1d}" Click="InsertTokenPreset_Click" Tag="{}{date:-1d}"/>
                                            <MenuItem Header="Next Week: {date:+7d}" Click="InsertTokenPreset_Click" Tag="{}{date:+7d}"/>
                                            <MenuItem Header="Next Month: {date:+1m}" Click="InsertTokenPreset_Click" Tag="{}{date:+1m}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>

                                <Button Content="+ {time} ▾" Style="{StaticResource TokenChipDateStyle}" Margin="0,0,5,5" ToolTip="Left-click to insert {time}. Right-click for presets." Click="InsertTokenChip_Click" Tag="{}{time}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="24-Hour with seconds: {time} (14:30:15)" Click="InsertTokenPreset_Click" Tag="{}{time}"/>
                                            <MenuItem Header="12-Hour AM/PM: {time:hh:mm tt} (02:30 PM)" Click="InsertTokenPreset_Click" Tag="{}{time:hh:mm tt}"/>
                                            <MenuItem Header="24-Hour short: {time:HH:mm} (14:30)" Click="InsertTokenPreset_Click" Tag="{}{time:HH:mm}"/>
                                            <Separator/>
                                            <MenuItem Header="One hour later: {time:+1h:HH:mm}" Click="InsertTokenPreset_Click" Tag="{}{time:+1h:HH:mm}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>

                                <Button Content="+ {datetime}" Style="{StaticResource TokenChipDateStyle}" Margin="0,0,5,5" ToolTip="Inserts current date and time (yyyy-MM-dd HH:mm:ss). Custom formats: {datetime:yyyy-MM-ddTHH:mm:ss}" Click="InsertTokenChip_Click" Tag="{}{datetime}"/>
                                
                                <Button Content="+ {guid} ▾" Style="{StaticResource TokenChipClipStyle}" Margin="0,0,5,5" ToolTip="Left-click to insert {guid}. Right-click for presets." Click="InsertTokenChip_Click" Tag="{}{guid}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Standard Hyphenated: {guid}" Click="InsertTokenPreset_Click" Tag="{}{guid}"/>
                                            <MenuItem Header="Uppercase: {guid:upper}" Click="InsertTokenPreset_Click" Tag="{}{guid:upper}"/>
                                            <MenuItem Header="Compact 32-Hex: {guid:N}" Click="InsertTokenPreset_Click" Tag="{}{guid:N}"/>
                                            <MenuItem Header="Braced: {guid:B}" Click="InsertTokenPreset_Click" Tag="{}{guid:B}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>

                                <Button Content="+ {clipboard}" Style="{StaticResource TokenChipClipStyle}" Margin="0,0,5,5" ToolTip="Inserts current clipboard text. Modifiers: {clipboard:trim}, {clipboard:upper}, {clipboard:urlencode}" Click="InsertTokenChip_Click" Tag="{}{clipboard}"/>
                                <Button Content="+ {username}" Style="{StaticResource TokenChipClipStyle}" Margin="0,0,5,5" ToolTip="Inserts current Windows username. Also supports {machine} and {env:VARIABLE}" Click="InsertTokenChip_Click" Tag="{}{username}"/>
                                <Button Content="+ {active_window}" Style="{StaticResource TokenChipClipStyle}" Margin="0,0,5,5" ToolTip="Inserts active window title. Also supports {active_process}" Click="InsertTokenChip_Click" Tag="{}{active_window}"/>
                                <Button Content="+ {cursor}" Style="{StaticResource TokenChipClipStyle}" Margin="0,0,5,5" ToolTip="Positions the cursor caret here post-paste" Click="InsertTokenChip_Click" Tag="{}{cursor}"/>
                                <Button Content="+ {text:Label}" Style="{StaticResource TokenChipPromptStyle}" Margin="0,0,5,5" ToolTip="Prompts for a single-line text input. Supports defaults: {text:Label|Default}" Click="InsertTokenChip_Click" Tag="{}{text:Label}"/>
                                <Button Content="+ {choice:Label|Opt1=Val1,Opt2}" Style="{StaticResource TokenChipPromptStyle}" Margin="0,0,5,5" ToolTip="Prompts for a single selection. Supports default: {choice:Label|Opt1=Val1*,Opt2}" Click="InsertTokenChip_Click" Tag="{}{choice:Label|Opt1=Val1,Opt2}"/>
                                <Button Content="+ {number:Label} ▾" Style="{StaticResource TokenChipPromptStyle}" Margin="0,0,5,5" ToolTip="Prompts for a numeric value. Supports optional min,max and default: {number:Label|min,max|default}" Click="InsertTokenChip_Click" Tag="{}{number:Quantity}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Standard: {number:Quantity}" Tag="{}{number:Quantity}" Click="InsertTokenPreset_Click"/>
                                            <MenuItem Header="1 to 100: {number:Count|1,100|10}" Tag="{}{number:Count|1,100|10}" Click="InsertTokenPreset_Click"/>
                                            <MenuItem Header="1 to 10: {number:Priority|1,10|1}" Tag="{}{number:Priority|1,10|1}" Click="InsertTokenPreset_Click"/>
                                            <MenuItem Header="0 to 120: {number:Age|0,120|25}" Tag="{}{number:Age|0,120|25}" Click="InsertTokenPreset_Click"/>
                                            <MenuItem Header="Range: {number:Retries|1,5}" Tag="{}{number:Retries|1,5}" Click="InsertTokenPreset_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button Content="+ {multiline:Label}" Style="{StaticResource TokenChipPromptStyle}" Margin="0,0,5,5" ToolTip="Prompts for multi-line text input. Supports defaults: {multiline:Label|Default}" Click="InsertTokenChip_Click" Tag="{}{multiline:Label}"/>
                                <Button Content="+ {date_picker:Label} ▾" Style="{StaticResource TokenChipPromptStyle}" Margin="0,0,5,5" ToolTip="Prompts with an interactive date picker. Supports custom formats: {date_picker:Label|Format}" Click="InsertTokenChip_Click" Tag="{}{date_picker:DueDate}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Standard: {date_picker:DueDate|yyyy-MM-dd}" Tag="{}{date_picker:DueDate|yyyy-MM-dd}" Click="InsertTokenPreset_Click"/>
                                            <MenuItem Header="US Format: {date_picker:DueDate|MM/dd/yyyy}" Tag="{}{date_picker:DueDate|MM/dd/yyyy}" Click="InsertTokenPreset_Click"/>
                                            <MenuItem Header="EU Format: {date_picker:DueDate|dd/MM/yyyy}" Tag="{}{date_picker:DueDate|dd/MM/yyyy}" Click="InsertTokenPreset_Click"/>
                                            <MenuItem Header="Compact: {date_picker:DueDate|yyyyMMdd}" Tag="{}{date_picker:DueDate|yyyyMMdd}" Click="InsertTokenPreset_Click"/>
                                            <MenuItem Header="Full Date: {date_picker:DueDate|dddd, MMMM d, yyyy}" Tag="{}{date_picker:DueDate|dddd, MMMM d, yyyy}" Click="InsertTokenPreset_Click"/>
                                            <MenuItem Header="Next Week: {date_picker:DueDate|MM/dd/yyyy|+7d}" Tag="{}{date_picker:DueDate|MM/dd/yyyy|+7d}" Click="InsertTokenPreset_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </WrapPanel>

                            <!-- Snippet Editor -->
                            <TextBox x:Name="SnippetTemplateBox" 
                                     Style="{StaticResource ModernTextBoxStyle}" 
                                     FontFamily="{StaticResource CodeFont}" 
                                     FontSize="13" 
                                     Height="110" 
                                     AcceptsReturn="True" 
                                     TextWrapping="Wrap" 
                                     VerticalScrollBarVisibility="Auto" 
                                     ToolTip="Enter the text template to expand. Click token chips above to insert dynamic tokens"
                                     SelectionChanged="SnippetTemplateBox_SelectionChanged"/>

                            <!-- Contextual Token Assistant Bar -->
                            <Border x:Name="TokenAssistantBorder" 
                                    Background="{DynamicResource BgTertiaryBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,8,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="💡" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <Border x:Name="AssistantBadgeBorder" 
                                                    Background="{DynamicResource AccentSubtleBrush}" 
                                                    CornerRadius="4" 
                                                    Padding="6,2" 
                                                    Margin="0,0,8,0"
                                                    Visibility="Collapsed">
                                                <TextBlock x:Name="AssistantTokenBadge" 
                                                           Text="{}{date:format}" 
                                                           FontSize="11" 
                                                           FontFamily="{StaticResource CodeFont}" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" 
                                                   x:Name="AssistantDescriptionText" 
                                                   Text="Type '{' or move caret inside a token to see parameters and quick format options."
                                                   FontSize="11.5" 
                                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>

                                    <!-- Clickable Format & Parameter Pills -->
                                    <WrapPanel x:Name="AssistantOptionsPillsPanel" Margin="0,8,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <!-- Live Expansion Preview Card -->
                            <Border Background="{DynamicResource BgPrimaryBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="0,12,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="👁" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Live Expansion Preview" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" 
                                                Background="{DynamicResource BgSecondaryBrush}" 
                                                BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="4" 
                                                Padding="6,2" 
                                                Margin="0,0,8,0" 
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="SnippetPreviewStatsText" 
                                                       Text="0 chars • 0 tokens" 
                                                       FontSize="10.5" 
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Border>

                                        <Button Grid.Column="2" 
                                                x:Name="RefreshSnippetPreviewBtn" 
                                                Content="↺ Refresh" 
                                                Style="{StaticResource SecondaryButtonStyle}" 
                                                FontSize="11" 
                                                Padding="7,2" 
                                                ToolTip="Refresh live evaluation"
                                                Click="RefreshSnippetPreviewBtn_Click"/>
                                    </Grid>

                                    <Border Background="{DynamicResource BgInputBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,8"
                                            MinHeight="56"
                                            MaxHeight="140">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <TextBlock x:Name="SnippetLivePreviewText" 
                                                       Text="Type a snippet template above to see a real-time expansion preview..." 
                                                       FontFamily="{StaticResource CodeFont}" 
                                                       FontSize="12" 
                                                       Foreground="{DynamicResource TextSecondaryBrush}" 
                                                       TextWrapping="Wrap"/>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Workflow Settings Box (Visible for Workflow type) -->
                    <Border x:Name="WorkflowSettingsGroup" 
                            Background="{DynamicResource CardBgBrush}" 
                            BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="16" 
                            Margin="0,0,0,16" 
                            Visibility="Collapsed">
                        <StackPanel>
                            <!-- Header with Title, Actions & Mode Switcher (2-Row Layout) -->
                            <Grid Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Row 0: Title & Primary Test Button -->
                                <TextBlock Grid.Row="0" Grid.Column="0" 
                                           Text="Workflow Execution Pipeline" 
                                           FontWeight="Bold" 
                                           FontSize="14" 
                                           VerticalAlignment="Center"/>

                                <Button Grid.Row="0" Grid.Column="1" 
                                        x:Name="TestWorkflowBtn" 
                                        Content="▶ Test Workflow" 
                                        Style="{StaticResource AccentButtonStyle}" 
                                        Click="TestWorkflowBtn_Click"/>

                                <!-- Row 1: Subtitle & Mode Switcher / Presets -->
                                <TextBlock Grid.Row="1" Grid.Column="0" 
                                           Text="Chain multiple steps together with shared variables, folder checks, and script logic." 
                                           FontSize="12" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           TextWrapping="Wrap" 
                                           VerticalAlignment="Center" 
                                           Margin="0,6,12,0"/>

                                <StackPanel Grid.Row="1" Grid.Column="1" 
                                            Orientation="Horizontal" 
                                            VerticalAlignment="Center" 
                                            Margin="0,6,0,0">
                                    <ComboBox x:Name="WorkflowModeCombo"
                                              Height="28"
                                              FontSize="12"
                                              Width="175"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              SelectionChanged="WorkflowModeCombo_SelectionChanged"
                                              ToolTip="Switch between Visual Step Builder and Advanced JavaScript mode">
                                        <ComboBoxItem Content="🧱 Visual Step Builder"/>
                                        <ComboBoxItem Content="⚡ JavaScript (Advanced)"/>
                                    </ComboBox>

                                    <!-- Presets Button -->
                                    <Button x:Name="WorkflowPresetsBtn" 
                                            Content="🎁 Presets ▾" 
                                            Style="{StaticResource SecondaryButtonStyle}" 
                                            Click="WorkflowPresetsBtn_Click">
                                        <Button.ContextMenu>
                                            <ContextMenu x:Name="WorkflowPresetsMenu"/>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,4,0,12" SnapsToDevicePixels="True"/>

                            <!-- VISUAL MODE CONTAINER -->
                            <StackPanel x:Name="WorkflowVisualContainer">
                                <!-- Visual Toolbar: Expand/Collapse All, Convert to Script, Add Step -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Button x:Name="WorkflowToggleAllExpandBtn" 
                                                Style="{StaticResource SecondaryButtonStyle}" 
                                                Margin="0,0,6,0" 
                                                Padding="8,4" 
                                                FontSize="11" 
                                                Click="WorkflowToggleAllExpandBtn_Click" 
                                                ToolTip="Collapse all step cards">
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="WorkflowToggleAllIcon" 
                                                      Width="12" Height="12" 
                                                      Stretch="Uniform" 
                                                      Margin="0,0,5,0"
                                                      Stroke="{DynamicResource TextPrimaryBrush}" 
                                                      StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" 
                                                      StrokeEndLineCap="Round" 
                                                      StrokeLineJoin="Round"
                                                      Data="M 2,3.5 L 8.5,3.5 M 4,8 L 8.5,8 M 6,12.5 L 8.5,12.5 M 13,12.5 L 13,4 M 10.5,6.5 L 13,4 L 15.5,6.5"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock x:Name="WorkflowToggleAllText" Text="Collapse All" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ConvertToJsBtn" Content="⚡ Convert to JavaScript" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11" ToolTip="Translate all visual steps into clean JavaScript code" Click="ConvertToJsBtn_Click"/>
                                    </StackPanel>

                                    <!-- Add Step Button with Dropdown -->
                                    <Button Grid.Column="2" x:Name="AddStepBtn" Content="+ Add Step ▾" Style="{StaticResource AccentButtonStyle}" Padding="12,5" Click="AddStepBtn_Click">
                                        <Button.ContextMenu>
                                            <ContextMenu x:Name="AddStepContextMenu">
                                                <MenuItem Header="Prompt User" Click="AddStepMenuItem_Click" Tag="Prompt"/>
                                                <MenuItem Header="Open URL / Web" Click="AddStepMenuItem_Click" Tag="OpenUrl"/>
                                                <MenuItem Header="Ensure Folder Exists" Click="AddStepMenuItem_Click" Tag="EnsureDirectory"/>
                                                <MenuItem Header="Launch Application" Click="AddStepMenuItem_Click" Tag="LaunchApp"/>
                                                <MenuItem Header="Inject Snippet" Click="AddStepMenuItem_Click" Tag="InjectSnippet"/>
                                                <MenuItem Header="Delay / Wait" Click="AddStepMenuItem_Click" Tag="Delay"/>
                                                <MenuItem Header="Execute Action / Folder" Click="AddStepMenuItem_Click" Tag="ExecuteAction"/>
                                                <MenuItem Header="Inline Script (JS)" Click="AddStepMenuItem_Click" Tag="RunScript"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>

                                <!-- Step Cards Host -->
                                <StackPanel x:Name="WorkflowStepsHost" Margin="0,0,0,8"/>

                                <!-- Empty State Display -->
                                <Border x:Name="WorkflowEmptyState" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="30,20" Margin="0,0,0,8" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🔀" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                        <TextBlock Text="No Steps Added Yet" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Click '+ Add Step' to build your pipeline or pick a starter template from 'Presets'." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,12"/>
                                        <Button Content="Choose a Preset Template..." Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Center" Click="WorkflowPresetsBtn_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- SCRIPT MODE CONTAINER -->
                            <StackPanel x:Name="WorkflowScriptContainer" Visibility="Collapsed">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="JavaScript Script Editor (Powered by Jint)" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" x:Name="MaximizeScriptEditorBtn" Content="⛶ Maximize" Style="{StaticResource SecondaryButtonStyle}" FontSize="11" Padding="8,4" Margin="0,0,6,0" ToolTip="Toggle expanded full-view code editor" Click="MaximizeScriptEditorBtn_Click"/>
                                    <Button Grid.Column="2" x:Name="ToggleApiDrawerBtn" Content="📖 API &amp; Snippet Reference ▾" Style="{StaticResource SecondaryButtonStyle}" FontSize="11" Padding="8,4" Click="ToggleApiDrawerBtn_Click"/>
                                </Grid>

                                <!-- API Reference Drawer (Collapsible) -->
                                <Border x:Name="WorkflowApiDrawer" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10" Visibility="Collapsed">
                                    <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="WorkflowApiDrawerHost"/>
                                    </ScrollViewer>
                                </Border>

                                <!-- Script Editor Box -->
                                <Border x:Name="WorkflowScriptEditorHost" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource BgInputBrush}" Padding="4">
                                    <avalonedit:TextEditor x:Name="WorkflowScriptEditor"
                                                           SyntaxHighlighting="JavaScript"
                                                           ShowLineNumbers="True"
                                                           FontFamily="{StaticResource CodeFont}"
                                                           FontSize="12.5"
                                                           Height="280"
                                                           Background="Transparent"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           HorizontalScrollBarVisibility="Auto"
                                                           VerticalScrollBarVisibility="Auto"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Context Process Filter Settings -->
                    <Border x:Name="ContextProcessFilterGroup"
                            Background="{DynamicResource CardBgBrush}" 
                            BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="16"
                            AllowDrop="True"
                            DragOver="ProcessFilterGroup_DragOver"
                            Drop="ProcessFilterGroup_Drop">
                        <StackPanel>
                            <TextBlock Text="Process Context Rules (Optional)" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                            <TextBlock Text="Scope this action to specific applications or browser URLs. Drag executables or use target tools." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,0"/>

                            <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,8,0,12" SnapsToDevicePixels="True"/>

                            <!-- Allowed Processes -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Allowed Processes" 
                                               FontWeight="SemiBold" 
                                               FontSize="12.5" 
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Leave empty to allow all applications" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource TextSecondaryBrush}" 
                                               Margin="0,1,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" 
                                        Content="＋ Add Process ▾" 
                                        Style="{StaticResource SecondaryButtonStyle}" 
                                        Padding="9,3" 
                                        FontSize="11" 
                                        FontWeight="Medium" 
                                        VerticalAlignment="Center"
                                        ToolTip="Add allowed process via crosshair, running apps, or file browser"
                                        Tag="Allowed"
                                        Click="AddProcessMenuButton_Click"/>
                            </Grid>
                            <controls:TagInputControl x:Name="AllowedProcessesTagInput" 
                                                      Variant="Allowed" 
                                                      Placeholder="Type process (e.g. code.exe) and press Enter..." 
                                                      Margin="0,0,0,14"/>

                            <!-- Excluded Processes -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Excluded Processes" 
                                               FontWeight="SemiBold" 
                                               FontSize="12.5" 
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Action will not trigger if any match" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource TextSecondaryBrush}" 
                                               Margin="0,1,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" 
                                        Content="＋ Add Process ▾" 
                                        Style="{StaticResource SecondaryButtonStyle}" 
                                        Padding="9,3" 
                                        FontSize="11" 
                                        FontWeight="Medium" 
                                        VerticalAlignment="Center"
                                        ToolTip="Add excluded process via crosshair, running apps, or file browser"
                                        Tag="Excluded"
                                        Click="AddProcessMenuButton_Click"/>
                            </Grid>
                            <controls:TagInputControl x:Name="ExcludedProcessesTagInput" 
                                                      Variant="Excluded" 
                                                      Placeholder="Type process (e.g. chrome.exe) and press Enter..." 
                                                      Margin="0,0,0,16"/>

                            <!-- Browser URL Filtering Section (Collapsible Expander) -->
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                <StackPanel>
                                    <!-- Collapsible Header -->
                                    <Border x:Name="BrowserUrlSectionHeader" 
                                            Background="Transparent" 
                                            Cursor="Hand" 
                                            Padding="4,6" 
                                            CornerRadius="6"
                                            PreviewMouseLeftButtonDown="BrowserUrlSectionHeader_PreviewMouseLeftButtonDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🌐" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Browser Tab &amp; URL Rules (Optional)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Filters active browser tabs (Chrome, Edge, Firefox, Brave). Supports wildcards: *github.com*, localhost:*" 
                                                           FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <!-- Rules Configured Badge (Visible when collapsed with active rules) -->
                                            <Border Grid.Column="2" x:Name="UrlRulesActiveBadge" 
                                                    Background="{DynamicResource AccentColorBrush}" 
                                                    CornerRadius="10" 
                                                    Padding="8,2" 
                                                    Margin="8,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="Collapsed">
                                                <TextBlock x:Name="UrlRulesActiveBadgeText" Text="Configured" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                            </Border>

                                            <!-- Expand / Collapse Indicator -->
                                            <TextBlock Grid.Column="3" x:Name="BrowserUrlSectionChevron" 
                                                       Text="▶" FontSize="11" 
                                                       Foreground="{DynamicResource TextSecondaryBrush}" 
                                                       VerticalAlignment="Center" 
                                                       Margin="8,0,4,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- Collapsible Content -->
                                    <StackPanel x:Name="BrowserUrlSectionContent" Margin="0,10,0,0" Visibility="Collapsed">
                                        <!-- Allowed URLs Header -->
                                        <Grid Margin="0,4,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" 
                                                       Text="Allowed URLs (Comma-separated or pill tags, leave blank for all)" 
                                                       FontWeight="Medium" 
                                                       FontSize="12" 
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" 
                                                    Background="{DynamicResource BgTertiaryBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="7,2"
                                                    Cursor="Cross"
                                                    ToolTip="Click &amp; drag crosshair onto an open browser tab to capture into Allowed URLs"
                                                    Tag="AllowedUrl"
                                                    PreviewMouseLeftButtonDown="ProcessCrosshair_PreviewMouseLeftButtonDown">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🎯" FontSize="11" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Target Tab URL" FontSize="11" FontWeight="Medium"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <controls:TagInputControl x:Name="AllowedUrlsTagInput" 
                                                                  Variant="Allowed"
                                                                  Placeholder="e.g. *github.com*, localhost:* (press Enter)..." 
                                                                  Margin="0,0,0,12"/>

                                        <!-- Excluded URLs Header -->
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" 
                                                       Text="Excluded URLs (Action suppressed on these pages)" 
                                                       FontWeight="Medium" 
                                                       FontSize="12" 
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" 
                                                    Background="{DynamicResource BgTertiaryBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="7,2"
                                                    Cursor="Cross"
                                                    ToolTip="Click &amp; drag crosshair onto an open browser tab to capture into Excluded URLs"
                                                    Tag="ExcludedUrl"
                                                    PreviewMouseLeftButtonDown="ProcessCrosshair_PreviewMouseLeftButtonDown">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🎯" FontSize="11" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Target Tab URL" FontSize="11" FontWeight="Medium"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <controls:TagInputControl x:Name="ExcludedUrlsTagInput" 
                                                                  Variant="Excluded"
                                                                  Placeholder="e.g. *youtube.com*, *netflix.com* (press Enter)..."/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Recycle Bin Overview Panel (Visible when Recycle Bin root folder is selected) -->
            <ScrollViewer x:Name="RecycleBinOverviewPanel"
                          Grid.Row="1"
                          Grid.RowSpan="2"
                          Background="Transparent"
                          VerticalScrollBarVisibility="Auto"
                          Padding="28,24"
                          Visibility="Collapsed">
                <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="🗑" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Recycle Bin" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="RecycleBinCountDetailText" Text="0 items deleted" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="About the Recycle Bin" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock Text="Items deleted from your actions list are temporarily held here. Hotkeys assigned to deleted items are inactive to prevent conflicts. You can inspect any item, restore it back to its original location, or permanently purge it."
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18"/>
                            <TextBlock x:Name="RecycleBinRetentionSummaryText"
                                       Text="Retention policy: Items are retained according to your settings."
                                       FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="EmptyRecycleBinFromSettingsBtn"
                                Content="🗑 Empty Recycle Bin"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Foreground="{DynamicResource ErrorBrush}"
                                BorderBrush="{DynamicResource ErrorBrush}"
                                Padding="14,8"
                                FontWeight="SemiBold"
                                Click="EmptyRecycleBinFromSettingsBtn_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" 
                Background="{DynamicResource BgSecondaryBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock x:Name="AppVersionText" Grid.Column="1" Text="v..." FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
