                                        <Grid Margin="0,2.5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{DynamicResource KeyBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="Alt+Enter" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Open &amp; edit item in Action Manager" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Group 3: Navigation & Window Shortcuts -->
                                <Border Background="{DynamicResource BgInputBrush}" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="NAVIGATION &amp; WINDOW SHORTCUTS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>

                                        <Grid Margin="0,2.5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{DynamicResource KeyBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="Hold Ctrl" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Show quick filter jump keys (Ctrl+1 .. Ctrl+5)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,2.5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{DynamicResource KeyBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="Ctrl+1 .. 5" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Switch filter pills directly" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,2.5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{DynamicResource KeyBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="↑ / ↓" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Navigate action &amp; calculator results" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,2.5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{DynamicResource KeyBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="Tab" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Cycle filter pills / Chain calculator answer" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,2.5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{DynamicResource KeyBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="Backspace" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Back out of current folder scope (when search is empty)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,2.5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{DynamicResource KeyBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="Esc" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Exit Calc View / Back out of folder / Close palette" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,2.5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{DynamicResource KeyBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="Ctrl+S" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Select Sort Mode (Smart, Alphabetical, Frequent, Recent, Tree)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,2.5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{DynamicResource KeyBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="Ctrl+M" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Open Action Manager" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,2.5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{DynamicResource KeyBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="Ctrl+," FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Open Application Settings" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,2.5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{DynamicResource KeyBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="? / F1" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Toggle this shortcuts &amp; help window" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Group 4: Quick Calculations & Conversions -->
                                <Border Background="{DynamicResource BgInputBrush}" CornerRadius="6" Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Text="QUICK CALCULATIONS &amp; CONVERSIONS (= or @calc)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>

                                        <Grid Margin="0,2.5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{DynamicResource KeyBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="= 120 * 1.15" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Math, percentages &amp; scientific (50 + 15%, 20% of 850, sin(45), sqrt(144))" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,2.5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{DynamicResource KeyBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="32px to rem" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Conversions: CSS, currency, temperature, length, weight, bytes, volume" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,2.5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{DynamicResource KeyBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="= now + 3d" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Date countdowns &amp; time (now + 3d, time until Christmas, unix 1727184000)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Discovery Tip to Full Calc Workspace -->
                                        <Border Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="💡 " FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="Tip: Type = or @calc to open the full Calculator Workspace with interactive keypad, conversion categories, and complete 5-tab reference guide." 
                                                           FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Overlay: Alternative Date/Time Measurements Flyout -->
            <Grid Grid.Row="0" Grid.RowSpan="5" 
                  x:Name="CalculatorUnitsOverlay" 
                  Background="{DynamicResource BgSecondaryBrush}"
                  Visibility="Collapsed">
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="{DynamicResource BgSecondaryBrush}"
                        Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Title & Close -->
                            <RowDefinition Height="Auto"/> <!-- Hero Natural Time Breakdown Card -->
                            <RowDefinition Height="Auto"/> <!-- Search & Category Chips -->
                            <RowDefinition Height="*"/>    <!-- Scrollable Units List -->
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="🧮 Alternative Measurements &amp; Conversions" 
                                           FontSize="13.5" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Click 'Paste' to use as result, or 'Copy' to copy value or full sentence" 
                                           FontSize="10.5" 
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                            <Button x:Name="CloseUnitsOverlayBtn" 
                                    Click="CloseUnitsOverlayBtn_Click" 
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Top"
                                    Background="Transparent" 
                                    BorderThickness="0" 
                                    Cursor="Hand" 
                                    Padding="6,2">
                                <TextBlock Text="✕" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Hero Card: Natural Time Breakdown (Format A & B - Compact 2-Row Banner) -->
                        <Border Grid.Row="1"
                                x:Name="HeroBreakdownCard"
                                Background="{DynamicResource BgTertiaryBrush}"
                                BorderBrush="{DynamicResource AccentSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,5"
                                Margin="0,0,0,7"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Hierarchical Format -->
                                <Grid Grid.Row="0" Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⏳ Weeks &amp; Days:" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" x:Name="HeroHierarchicalValueText" Text="13 weeks, 1 day, 4 hours, 19m" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Button Style="{StaticResource CalcUnitActionButtonStyle}" Click="HeroHierarchicalPaste_Click" ToolTip="Paste into active window" Margin="0,0,4,0" Padding="5,1">
                                            <TextBlock Text="Paste ↵" FontSize="10"/>
                                        </Button>
                                        <Button Style="{StaticResource CalcUnitActionButtonStyle}" Click="HeroHierarchicalCopyValue_Click" ToolTip="Copy value" Margin="0,0,4,0" Padding="5,1">
                                            <TextBlock Text="Copy 📋" FontSize="10"/>
                                        </Button>
                                        <Button Style="{StaticResource CalcUnitActionButtonStyle}" Click="HeroHierarchicalCopySentence_Click" ToolTip="Copy sentence" Padding="5,1">
                                            <TextBlock Text="Copy 💬" FontSize="10"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 1: Cumulative Days Format -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📅 Total Days:" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" x:Name="HeroCumulativeValueText" Text="92 days, 4 hours, 19m" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Button Style="{StaticResource CalcUnitActionButtonStyle}" Click="HeroCumulativePaste_Click" ToolTip="Paste into active window" Margin="0,0,4,0" Padding="5,1">
                                            <TextBlock Text="Paste ↵" FontSize="10"/>
                                        </Button>
                                        <Button Style="{StaticResource CalcUnitActionButtonStyle}" Click="HeroCumulativeCopyValue_Click" ToolTip="Copy value" Margin="0,0,4,0" Padding="5,1">
                                            <TextBlock Text="Copy 📋" FontSize="10"/>
                                        </Button>
                                        <Button Style="{StaticResource CalcUnitActionButtonStyle}" Click="HeroCumulativeCopySentence_Click" ToolTip="Copy sentence" Padding="5,1">
                                            <TextBlock Text="Copy 💬" FontSize="10"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Search Bar & Category Chips (Single Sleek Row) -->
                        <Grid Grid.Row="2" Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Search Bar -->
                            <Border Grid.Column="0"
                                    Background="{DynamicResource BgInputBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="6,3"
                                    Margin="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1"
                                             x:Name="UnitsSearchTextBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                                             FontSize="11.5"
                                             VerticalAlignment="Center"
                                             TextChanged="UnitsSearchTextBox_TextChanged"/>
                                </Grid>
                            </Border>

                            <!-- Category Chips Bar -->
                            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" x:Name="CategoryChipsContainer" VerticalAlignment="Center"/>
                            </ScrollViewer>
                        </Grid>

                        <!-- Units List (High-Density Cards) -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="UnitsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgInputBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="8,5"
                                                Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Left Content -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <!-- Row 1: Concept Title & Category Badge & Formatted Value -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ConceptTitle}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource AccentBrush}"/>
                                                        <Border CornerRadius="3"
                                                                Background="{DynamicResource AccentSubtleBrush}"
                                                                Padding="4,1"
                                                                Margin="6,0,0,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayCategory}"
                                                                       FontSize="9"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AccentBrush}"/>
                                                        </Border>
                                                        <TextBlock Text="•"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   Margin="6,0,6,0"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding FormattedValue}"
                                                                   FontSize="11.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Row 2: Conversational Sentence -->
                                                    <TextBlock Text="{Binding ConversationalSentence}"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding ConversationalSentence}"/>
                                                </StackPanel>

                                                <!-- Right: Actions -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <Button Style="{StaticResource CalcUnitActionButtonStyle}"
                                                            Click="FlyoutUseUnitBtn_Click"
                                                            ToolTip="Use this measurement as the answer and paste into active window"
                                                            Margin="0,0,4,0"
                                                            Padding="5,2">
                                                        <TextBlock Text="Paste ↵" FontSize="10"/>
                                                    </Button>
                                                    <Button Style="{StaticResource CalcUnitActionButtonStyle}"
                                                            Click="FlyoutCopyValueBtn_Click"
                                                            ToolTip="Copy value to clipboard"
                                                            Margin="0,0,4,0"
                                                            Padding="5,2">
                                                        <TextBlock Text="Copy Value 📋" FontSize="10"/>
                                                    </Button>
                                                    <Button Style="{StaticResource CalcUnitActionButtonStyle}"
                                                            Click="FlyoutCopySentenceBtn_Click"
                                                            ToolTip="Copy conversational sentence to clipboard"
                                                            Padding="5,2">
                                                        <TextBlock Text="Copy Sentence 💬" FontSize="10"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Overlay: Folder Execution Confirmation Modal -->
            <Grid Grid.Row="0" Grid.RowSpan="5"
                  x:Name="FolderExecutionConfirmOverlay"
                  Background="#99000000"
                  Visibility="Collapsed">
                <Border Width="500"
                        MaxHeight="430"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Title & Subtitle -->
                            <RowDefinition Height="*"/>    <!-- Action Preview List -->
                            <RowDefinition Height="Auto"/> <!-- Subfolder Option & Buttons -->
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📁 " FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FolderConfirmTitleText"
                                               Text="Execute All Actions in Folder?"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="FolderConfirmSubtitleText"
                                           Text="The following actions will be executed sequentially:"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    x:Name="CloseFolderConfirmBtn"
                                    Click="CloseFolderConfirmBtn_Click"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="6,2">
                                <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Action Preview List -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource BgInputBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="6"
                                Margin="0,0,0,12"
                                MaxHeight="220">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="FolderConfirmActionsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,5" Margin="0,1" CornerRadius="4" Background="{DynamicResource CardBgBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding IconEmoji}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding PathBreadcrumb}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Visibility="{Binding BreadcrumbVisibility}"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" 
                                                            Background="{Binding TypeBadgeBg}" 
                                                            CornerRadius="3" 
                                                            Padding="4,1" 
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TypeBadgeText}" 
                                                                   FontSize="9.5" 
                                                                   FontWeight="SemiBold" 
                                                                   Foreground="{Binding TypeBadgeFg}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Subfolder Toggle & Action Buttons -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Include Subfolders Checkbox -->
                            <CheckBox Grid.Column="0"
                                      x:Name="FolderConfirmIncludeSubfoldersCheck"
                                      Content="Include subfolders"
                                      FontSize="11.5"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      VerticalAlignment="Center"
                                      IsChecked="True"
                                      Click="FolderConfirmIncludeSubfoldersCheck_Click"/>

                            <!-- Buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="FolderConfirmCancelBtn"
                                        Click="FolderConfirmCancelBtn_Click"
                                        Content="Cancel (Esc)"
                                        Cursor="Hand"
                                        Background="Transparent"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="10,6"
                                        Margin="0,0,8,0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="5"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button x:Name="FolderConfirmRunBtn"
                                        Click="FolderConfirmRunBtn_Click"
                                        Cursor="Hand"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontWeight="SemiBold"
                                        Padding="14,6">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="5"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="▶ " FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="FolderConfirmRunBtnText" Text="Run All Actions" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
