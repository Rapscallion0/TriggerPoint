<UserControl x:Class="TriggerPoint.UI.Controls.ColorPickerPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
    <Popup x:Name="FlyoutPopup"
           StaysOpen="False"
           AllowsTransparency="True"
           Placement="Bottom"
           PopupAnimation="Fade">
        <Border Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Width="268"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" Direction="270"/>
            </Border.Effect>

            <StackPanel>
                <!-- Title & Reset Button -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="PopupTitleText"
                               Text="Select Color"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            x:Name="ResetColorBtn"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="8,3"
                            FontSize="11"
                            Click="ResetColorBtn_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="ResetIndicatorBorder"
                                    Width="12" Height="12"
                                    CornerRadius="2"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Margin="0,0,5,0"
                                    Background="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="ResetBtnText" Text="Automatic" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,8" SnapsToDevicePixels="True"/>

                <!-- Swatches Matrix (10 columns x 5 rows) -->
                <UniformGrid x:Name="SwatchesGrid"
                             Columns="10"
                             Rows="5"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,8"/>

                <!-- Recent Colors Section -->
                <StackPanel x:Name="RecentColorsSection" Visibility="Collapsed" Margin="0,0,0,8">
                    <TextBlock Text="Recent Colors"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,4"/>
                    <WrapPanel x:Name="RecentColorsPanel"/>
                    <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,6,0,0" SnapsToDevicePixels="True"/>
                </StackPanel>

                <!-- Custom Hex & More Colors Section -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Hex Preview Swatch -->
                    <Border x:Name="HexPreviewSwatch"
                            Grid.Column="0"
                            Width="24" Height="24"
                            CornerRadius="3"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Background="#000000"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"/>

                    <!-- Hex Input Box -->
                    <TextBox x:Name="HexInputBox"
                             Grid.Column="1"
                             Height="24"
                             MaxLength="7"
                             FontSize="11.5"
                             FontFamily="{StaticResource CodeFont}"
                             VerticalContentAlignment="Center"
                             Padding="4,1"
                             Margin="0,0,4,0"
                             ToolTip="Hex color code (e.g. #FF5722)"
                             TextChanged="HexInputBox_TextChanged"
                             KeyDown="HexInputBox_KeyDown"/>

                    <!-- Apply Hex Button -->
                    <Button Grid.Column="2"
                            x:Name="ApplyHexBtn"
                            Content="OK"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="24"
                            Padding="8,1"
                            FontSize="11"
                            Margin="0,0,4,0"
                            ToolTip="Apply Hex Color"
                            Click="ApplyHexBtn_Click"/>

                    <!-- System Dialog Button -->
                    <Button Grid.Column="3"
                            x:Name="MoreColorsBtn"
                            Content="🎨"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="24" Width="26"
                            Padding="0"
                            FontSize="12"
                            ToolTip="More Colors (Windows Color Picker)"
                            Click="MoreColorsBtn_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Popup>
</UserControl>
