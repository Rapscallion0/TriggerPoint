<Window x:Class="TriggerPoint.UI.Views.EyedropperLoupeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eyedropper Loupe"
        Width="164"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        IsHitTestVisible="False">

    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.45" Direction="270"/>
        </Border.Effect>

        <Grid Margin="6,6,6,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Magnified Pixel Grid (11x11 @ 9x scale = 99x99) -->
            <Border Grid.Row="0"
                    Width="99" Height="99"
                    CornerRadius="4"
                    ClipToBounds="True"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center">
                <Grid>
                    <Image x:Name="LoupeImage"
                           Width="99" Height="99"
                           Stretch="Fill"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <Canvas>
                        <!-- Center pixel reticle box (pixel 5 of 0..10 is centered at x=45, y=45, width=9, height=9) -->
                        <Border Width="9" Height="9"
                                Canvas.Left="45" Canvas.Top="45"
                                BorderBrush="White"
                                BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.9" Color="Black"/>
                            </Border.Effect>
                        </Border>
                    </Canvas>
                </Grid>
            </Border>

            <!-- Bottom Pill: Color Dot + Hex String -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,8,0,0">
                <Border x:Name="ColorDot"
                        Width="16" Height="16"
                        CornerRadius="8"
                        Background="#8B5CF6"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1.5"
                        Margin="0,0,7,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3" Direction="270"/>
                    </Border.Effect>
                </Border>
                <TextBlock x:Name="HexText"
                           Text="#8B5CF6"
                           FontSize="11.5"
                           FontWeight="Bold"
                           FontFamily="Cascadia Code, Consolas, Courier New"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Keyboard & Action Hints -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BgTertiaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="6,5"
                    Margin="0,7,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Arrows: 1px • Shift: 10px"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Click / Enter: Pick • Esc: Cancel"
                               FontSize="10"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
