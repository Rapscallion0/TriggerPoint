<Window x:Class="TriggerPoint.UI.Views.WindowTargetingOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Target Window"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        Cursor="Cross"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseRightButtonDown="Window_PreviewMouseRightButtonDown">

    <Canvas x:Name="OverlayCanvas" Background="Transparent" IsHitTestVisible="True">
        <!-- Hover window bounding highlight rectangle -->
        <Border x:Name="HoverHighlightBorder"
                BorderBrush="{DynamicResource AccentColorBrush}"
                BorderThickness="2.5"
                Background="#183B82F6"
                CornerRadius="5"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#3B82F6" Opacity="0.75"/>
            </Border.Effect>
        </Border>

        <!-- Floating cursor tooltip badge -->
        <Border x:Name="FloatingTooltip"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,6"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.45" Direction="270"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🎯" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TooltipPromptText" 
                           Text="Click application window to select (Esc to cancel)" 
                           FontSize="12" 
                           FontWeight="Medium" 
                           Foreground="{DynamicResource TextPrimaryBrush}" 
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
