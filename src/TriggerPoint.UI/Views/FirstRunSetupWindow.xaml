<Window x:Class="TriggerPoint.UI.Views.FirstRunSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to TriggerPoint"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        KeyDown="Window_KeyDown">

    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" Direction="270"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with Reticle Icon -->
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource AccentBrush}" Margin="0,0,12,0">
                        <TextBlock Text="⌖" FontSize="22" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Welcome to TriggerPoint"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Precision shortcuts. Instant menus. Zero bloat."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Appearance Theme Selection Card -->
            <Border Grid.Row="1" 
                    Background="{DynamicResource BgTertiaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Appearance Theme"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,8"/>

                    <RadioButton x:Name="SystemThemeRadio" 
                                 GroupName="ThemeSelection"
                                 IsChecked="True"
                                 Margin="0,0,0,6"
                                 Checked="ThemeRadio_Checked">
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="🖥️  System Default (Recommended)" 
                                       FontWeight="Medium" 
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Automatically matches your Windows dark or light mode setting." 
                                       FontSize="11" 
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="DarkThemeRadio" 
                                 GroupName="ThemeSelection"
                                 Margin="0,0,0,6"
                                 Checked="ThemeRadio_Checked">
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="🌙  Dark Theme" 
                                       FontWeight="Medium" 
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Sleek, high-contrast dark aesthetic." 
                                       FontSize="11" 
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="LightThemeRadio" 
                                 GroupName="ThemeSelection"
                                 Checked="ThemeRadio_Checked">
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="☀️  Light Theme" 
                                       FontWeight="Medium" 
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Clean, bright, high-readability daylight aesthetic." 
                                       FontSize="11" 
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Starter Content Selection Card -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BgTertiaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,20">
                <CheckBox x:Name="StarterPackCheckBox"
                          IsChecked="True"
                          VerticalContentAlignment="Top">
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="Install Starter Pack &amp; Examples"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Seeds ready-to-use sample folders demonstrating radial cursor menus, interactive text snippets, and automated workflows."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="Tip: If you prefer a completely clean slate, uncheck this box to start with an empty configuration."
                                   FontSize="10"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </CheckBox>
            </Border>

            <!-- Footer / Get Started Button -->
            <Grid Grid.Row="3">
                <TextBlock Text="You can customize these anytime in Settings."
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                <Button x:Name="GetStartedBtn"
                        Content="Get Started (Enter)"
                        Style="{StaticResource AccentButtonStyle}"
                        FontWeight="SemiBold"
                        Padding="18,8"
                        HorizontalAlignment="Right"
                        IsDefault="True"
                        Click="GetStartedBtn_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
