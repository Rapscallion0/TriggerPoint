<Window x:Class="TriggerPoint.UI.Views.VariablePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Insert Token or Variable"
        Width="680" Height="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.4" Direction="270"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Search & Filter Toolbar -->
                <RowDefinition Height="*"/>    <!-- Items List -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,14" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Insert Token or Variable" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Search, filter, and insert Windows environment variables, system tokens, or workflow variables" 
                               FontSize="12" 
                               Foreground="{DynamicResource TextSecondaryBrush}" 
                               Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" 
                        Content="✕" 
                        Style="{StaticResource WindowControlButtonStyle}" 
                        Width="28" Height="28" 
                        Click="CancelBtn_Click"/>
            </Grid>

            <!-- Search & Filter Toolbar -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <!-- Search Box -->
                <TextBox x:Name="SearchBox" 
                         Style="{StaticResource ModernTextBoxStyle}" 
                         Height="36" 
                         FontSize="13"
                         Margin="0,0,0,8"
                         Tag="Search variables &amp; tokens by name, description, or live value..." 
                         TextChanged="SearchBox_TextChanged"
                         PreviewKeyDown="SearchBox_PreviewKeyDown"/>

                <!-- Filter Category Chips -->
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ChipAll" Content="All" Click="CategoryChip_Click" Tag="All" Margin="0,0,6,0" Padding="10,4" FontSize="11.5" FontWeight="SemiBold"/>
                    <Button x:Name="ChipEnv" Content="Windows Env (%VAR%)" Click="CategoryChip_Click" Tag="Env" Margin="0,0,6,0" Padding="10,4" FontSize="11.5"/>
                    <Button x:Name="ChipSystem" Content="System Tokens ({...})" Click="CategoryChip_Click" Tag="System" Margin="0,0,6,0" Padding="10,4" FontSize="11.5"/>
                    <Button x:Name="ChipWorkflow" Content="Workflow Variables" Click="CategoryChip_Click" Tag="Workflow" Margin="0,0,6,0" Padding="10,4" FontSize="11.5"/>
                </StackPanel>
            </StackPanel>

            <!-- Variables List -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource BgInputBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="6"
                    Margin="0,0,0,14">
                <ListBox x:Name="VariablesListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MouseDoubleClick="VariablesListBox_MouseDoubleClick"
                         SelectionChanged="VariablesListBox_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Margin" Value="2,1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="itemBorder" 
                                                Background="{TemplateBinding Background}" 
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="5" 
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Token Badge -->
                                <Border Grid.Column="0" 
                                        Background="{DynamicResource CardHeaderBgBrush}" 
                                        BorderBrush="{DynamicResource BorderBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="4" 
                                        Padding="6,3" 
                                        Margin="0,0,12,0" 
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Token}" 
                                               FontFamily="{StaticResource CodeFont}" 
                                               FontSize="12" 
                                               FontWeight="SemiBold" 
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </Border>

                                <!-- Details Stack -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Description}" 
                                               FontSize="12.5" 
                                               FontWeight="Medium" 
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding LiveValuePreview}" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource TextSecondaryBrush}" 
                                               TextTrimming="CharacterEllipsis" 
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Category Tag -->
                                <Border Grid.Column="2" 
                                        Background="{DynamicResource BgSecondaryBrush}" 
                                        BorderBrush="{DynamicResource BorderBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="3" 
                                        Padding="5,2" 
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayCategory}" 
                                               FontSize="10.5" 
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Footer -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="💡 Press ↑/↓ to navigate, Enter or double-click to insert, Esc to cancel" 
                           FontSize="11.5" 
                           Foreground="{DynamicResource TextSecondaryBrush}" 
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1" 
                        Content="Cancel" 
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Width="84" Height="32" 
                        Margin="0,0,8,0" 
                        Click="CancelBtn_Click"/>

                <Button Grid.Column="2" 
                        x:Name="InsertBtn" 
                        Content="Insert Token" 
                        Style="{StaticResource PrimaryButtonStyle}" 
                        Width="104" Height="32" 
                        IsEnabled="False" 
                        Click="InsertBtn_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
