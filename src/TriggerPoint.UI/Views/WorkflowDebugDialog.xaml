<Window x:Class="TriggerPoint.UI.Views.WorkflowDebugDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workflow Step Debugger"
        Width="880"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgSecondaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="*"/>    <!-- Main Body: Steps + Variables/Logs -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="WorkflowTitleText" Text="Debug Workflow: Workflow Name" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Step-by-step pipeline execution, live variable inspection, and execution timing metrics" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1"
                        x:Name="StatusBadge"
                        CornerRadius="4"
                        Background="{DynamicResource AccentSubtleBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        Padding="8,3"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="StatusBadgeText" Text="READY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Row 1: Debugger Controls Toolbar -->
        <Border Grid.Row="1" 
                Background="{DynamicResource CardBgBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="12,8" 
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                        x:Name="StepOverBtn" 
                        Content="⏭ Step Over (F10)" 
                        Style="{StaticResource AccentButtonStyle}" 
                        Padding="12,5" 
                        Margin="0,0,8,0"
                        Click="StepOverBtn_Click"/>

                <Button Grid.Column="1" 
                        x:Name="ContinueBtn" 
                        Content="▶ Continue (F5)" 
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Padding="12,5" 
                        Margin="0,0,8,0"
                        Click="ContinueBtn_Click"/>

                <Button Grid.Column="2" 
                        x:Name="ResetBtn" 
                        Content="↺ Reset" 
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Padding="10,5" 
                        Margin="0,0,8,0"
                        Click="ResetBtn_Click"/>

                <Button Grid.Column="3" 
                        x:Name="StopBtn" 
                        Content="⏹ Stop" 
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Padding="10,5" 
                        IsEnabled="False"
                        Click="StopBtn_Click"/>

                <!-- Simulation Safeguard Toggle -->
                <CheckBox Grid.Column="5"
                          x:Name="DryRunCheck"
                          Content="🛡 Dry-Run Simulation (Mock execution)"
                          FontSize="12"
                          FontWeight="SemiBold"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          ToolTip="When checked, steps simulate success without actually launching external apps or modifying Windows files."/>
            </Grid>
        </Border>

        <!-- Row 2: Split Body: Steps List & State Inspector -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Steps Pipeline Column -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource CardBgBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Execution Steps Pipeline" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,8"/>
                    <ListBox Grid.Row="1"
                             x:Name="StepsListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding BackgroundBrush}" 
                                        BorderBrush="{Binding BorderBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="8,6" 
                                        Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StepTitle}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding StepSubtitle}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- State & Log Inspector Column -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="180"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Variables Inspector Panel -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource CardBgBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="Live Variable State Inspector" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                            <TextBlock x:Name="VariableCountText" Text="0 variables" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        <ListBox Grid.Row="1"
                                 x:Name="VariablesListBox"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Key}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="4,2" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Step Execution Trace Log Panel -->
                <Border Grid.Row="2" 
                        Background="{DynamicResource CardBgBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="Execution Trace &amp; Output Log" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                            <Button Content="Clear" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="6,2" FontSize="10.5" Click="ClearLogBtn_Click"/>
                        </Grid>
                        <TextBox Grid.Row="1"
                                 x:Name="TraceLogBox"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource BgInputBrush}"
                                 BorderBrush="{DynamicResource BorderSubtleBrush}"
                                 BorderThickness="1"
                                 FontFamily="Consolas, Segoe UI Mono, monospace"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Padding="8"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Row 3: Footer -->
        <Border Grid.Row="3" Margin="0,12,0,0">
            <Grid>
                <TextBlock x:Name="FooterTimingText" Text="Total execution time: 0ms" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                <Button Content="Close" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="16,6" Click="CloseBtn_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
