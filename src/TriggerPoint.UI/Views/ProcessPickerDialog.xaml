<Window x:Class="TriggerPoint.UI.Views.ProcessPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browse Running Applications"
        Width="540" Height="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.4" Direction="270"/>
        </Border.Effect>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Select Running Application" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Choose an active window or process to add to context rules" 
                               FontSize="12" 
                               Foreground="{DynamicResource TextSecondaryBrush}" 
                               Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" 
                        Content="✕" 
                        Style="{StaticResource WindowControlButtonStyle}" 
                        Width="28" Height="28" 
                        Click="CancelBtn_Click"/>
            </Grid>

            <!-- Search Filter Box -->
            <Border Grid.Row="1" Margin="0,0,0,10">
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Height="34"
                         Tag="Filter applications..."
                         ToolTip="Filter processes by window title or process name"
                         TextChanged="SearchBox_TextChanged"/>
            </Border>

            <!-- Processes List -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource BgPrimaryBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8"
                    Margin="0,0,0,14">
                <ListBox x:Name="ProcessListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MouseDoubleClick="ProcessListBox_MouseDoubleClick"
                         SelectionChanged="ProcessListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6" Padding="8,6" Margin="0,1" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <TextBlock Grid.Column="0" 
                                               Text="{Binding Icon}" 
                                               FontSize="15" 
                                               Margin="0,0,10,0" 
                                               VerticalAlignment="Center"/>

                                    <!-- Window Title & Path -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" 
                                                   FontSize="13" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Description}" 
                                                   FontSize="11" 
                                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <!-- Process Name Badge -->
                                    <Border Grid.Column="2" 
                                            Background="{DynamicResource BgTertiaryBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProcessName}" 
                                                   FontSize="11" 
                                                   FontFamily="{StaticResource CodeFont}"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Buttons Row -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                        Content="🔄 Refresh" 
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Padding="10,6"
                        Click="RefreshBtn_Click"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Cancel" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Margin="0,0,8,0"
                            Padding="14,6"
                            Click="CancelBtn_Click"/>
                    <Button x:Name="SelectBtn" 
                            Content="Select Process" 
                            Style="{StaticResource AccentButtonStyle}" 
                            Padding="14,6"
                            IsEnabled="False"
                            Click="SelectBtn_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
